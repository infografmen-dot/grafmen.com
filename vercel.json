{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "astro",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": true,
  "redirects": [
    { "source": "/index.html", "destination": "/", "permanent": true },
    { "source": "/o-mnie.html", "destination": "/o-mnie/", "permanent": true },
    { "source": "/strony-www.html", "destination": "/strony-www/", "permanent": true },
    { "source": "/branding.html", "destination": "/branding/", "permanent": true },
    { "source": "/modernizacja.html", "destination": "/modernizacja/", "permanent": true },
    { "source": "/kontakt.html", "destination": "/kontakt/", "permanent": true },
    { "source": "/portfolio.html", "destination": "/portfolio/", "permanent": true },
    { "source": "/oferta.html", "destination": "/oferta/", "permanent": true },
    { "source": "/blog.html", "destination": "/blog/", "permanent": true },
    { "source": "/polityka-prywatnosci.html", "destination": "/polityka-prywatnosci/", "permanent": true },
    { "source": "/brief.html", "destination": "/brief-strony-www/", "permanent": true },
    { "source": "/brief-strony-www.html", "destination": "/brief-strony-www/", "permanent": true },
    { "source": "/brief-branding.html", "destination": "/brief-branding/", "permanent": true },
    { "source": "/portfolio-moich-ostatnich-projektow", "destination": "/portfolio/", "permanent": true },
    { "source": "/portfolio-moich-ostatnich-projektow/", "destination": "/portfolio/", "permanent": true },
    { "source": "/o-mnie-grafik-komputerowy-freelancer", "destination": "/o-mnie/", "permanent": true },
    { "source": "/o-mnie-grafik-komputerowy-freelancer/", "destination": "/o-mnie/", "permanent": true },
    { "source": "/kontakt-przemysl-podkarpacie-polska", "destination": "/kontakt/", "permanent": true },
    { "source": "/kontakt-przemysl-podkarpacie-polska/", "destination": "/kontakt/", "permanent": true },
    { "source": "/logo-hiker", "destination": "/portfolio/hiker/", "permanent": true },
    { "source": "/logo-hiker/", "destination": "/portfolio/hiker/", "permanent": true },
    { "source": "/strona_drew_art", "destination": "/portfolio/drew-art/", "permanent": true },
    { "source": "/strona_drew_art/", "destination": "/portfolio/drew-art/", "permanent": true },
    { "source": "/katalog_drew_art", "destination": "/portfolio/katalog-drew-art/", "permanent": true },
    { "source": "/katalog_drew_art/", "destination": "/portfolio/katalog-drew-art/", "permanent": true },
    { "source": "/kancelaria_lampa_logo", "destination": "/portfolio/kancelaria-lampa/", "permanent": true },
    { "source": "/kancelaria_lampa_logo/", "destination": "/portfolio/kancelaria-lampa/", "permanent": true },
    { "source": "/portfolio_identyfikacja_wizualna_logo_te_solutions", "destination": "/portfolio/te-solutions/", "permanent": true },
    { "source": "/portfolio_identyfikacja_wizualna_logo_te_solutions/", "destination": "/portfolio/te-solutions/", "permanent": true },
    { "source": "/gazetki_reklamowe", "destination": "/portfolio/gazetka-drewmar/", "permanent": true },
    { "source": "/gazetki_reklamowe/", "destination": "/portfolio/gazetka-drewmar/", "permanent": true },
    { "source": "/portfolio_logo_mpec_przemysl", "destination": "/portfolio/mpec-przemysl/", "permanent": true },
    { "source": "/portfolio_logo_mpec_przemysl/", "destination": "/portfolio/mpec-przemysl/", "permanent": true },
    { "source": "/portfolio_logo_self-invest", "destination": "/portfolio/self-invest/", "permanent": true },
    { "source": "/portfolio_logo_self-invest/", "destination": "/portfolio/self-invest/", "permanent": true },
    { "source": "/portfolio_katalog_targi_drewmar", "destination": "/portfolio/katalog-targowy-drewmar/", "permanent": true },
    { "source": "/portfolio_katalog_targi_drewmar/", "destination": "/portfolio/katalog-targowy-drewmar/", "permanent": true },
    { "source": "/portfolio/gazetki-reklamowe.html", "destination": "/portfolio/gazetka-drewmar/", "permanent": true },
    { "source": "/portfolio/gazetki-reklamowe", "destination": "/portfolio/gazetka-drewmar/", "permanent": true },
    { "source": "/portfolio/gazetki-reklamowe/", "destination": "/portfolio/gazetka-drewmar/", "permanent": true },
    { "source": "/portfolio/logo-hiker.html", "destination": "/portfolio/hiker/", "permanent": true },
    { "source": "/portfolio/logo-hiker", "destination": "/portfolio/hiker/", "permanent": true },
    { "source": "/portfolio/logo-hiker/", "destination": "/portfolio/hiker/", "permanent": true },
    { "source": "/portfolio/:slug.html", "destination": "/portfolio/:slug/", "permanent": true },
    { "source": "/en/index.html", "destination": "/en/", "permanent": true },
    { "source": "/en/websites.html", "destination": "/en/websites/", "permanent": true },
    { "source": "/en/branding.html", "destination": "/en/branding/", "permanent": true },
    { "source": "/en/redesign.html", "destination": "/en/redesign/", "permanent": true },
    { "source": "/en/about.html", "destination": "/en/about/", "permanent": true },
    { "source": "/en/contact.html", "destination": "/en/contact/", "permanent": true },
    { "source": "/en/portfolio.html", "destination": "/en/portfolio/", "permanent": true },
    { "source": "/en/blog.html", "destination": "/en/blog/", "permanent": true },
    { "source": "/en/privacy-policy.html", "destination": "/en/privacy-policy/", "permanent": true },
    { "source": "/en/brief-website.html", "destination": "/en/brief-website/", "permanent": true },
    { "source": "/en/brief-branding.html", "destination": "/en/brief-branding/", "permanent": true },
    { "source": "/en/portfolio/:slug.html", "destination": "/en/portfolio/:slug/", "permanent": true },
    { "source": "/film-hiker", "destination": "/portfolio/hiker/", "permanent": true },
    { "source": "/film-hiker/", "destination": "/portfolio/hiker/", "permanent": true }
  ],
  "headers": [
    {
      "source": "/fonts/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://i.ytimg.com; font-src 'self' data:; media-src 'self' data:; connect-src 'self' https://api.web3forms.com; frame-src 'self' https://www.youtube-nocookie.com https://www.youtube.com; object-src 'none'; base-uri 'self'; form-action 'self' https://api.web3forms.com; frame-ancestors 'none';" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" },
        { "key": "Strict-Transport-Security", "value": "max-age=31536000" }
      ]
    },
    {
      "source": "/(.*)",
      "has": [
        { "type": "host", "value": "grafmen-com.vercel.app" }
      ],
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
      ]
    }
  ]
}
