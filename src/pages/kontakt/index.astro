---
import BaseLayout from '../../layouts/BaseLayout.astro';

const title = "Kontakt i wycena projektu | Grafmen, Przemyśl";
const description = "Skontaktuj się z Krzysztofem Krawczykiem z Grafmen. Strony WWW, logo i branding. Napisz o swoim projekcie i zapytaj o indywidualną wycenę.";
---
<BaseLayout title={title} description={description} currentNav="contact" bodyClass="service-page">
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "ContactPage",
      "name": "Kontakt i wycena projektu",
      "url": "https://grafmen.com/kontakt/",
      "mainEntity": {
        "@type": "Person",
        "name": "Krzysztof Krawczyk",
        "email": "info@grafmen.com",
        "telephone": "+48694179217"
      }
    })} />
    <script src="/contact.js" defer></script>
  </Fragment>

  <main id="main-content">
    <section class="service-hero contact-hero">
      <div class="home-inner">
        <p class="home-kicker">KONTAKT / GRAFMEN</p>
        <h1>Opowiedz mi<br>o&nbsp;swoim projekcie.</h1>
        <p class="home-lead">Strona internetowa, logo czy materiały firmowe? Napisz, czego potrzebujesz. Wspólnie ustalimy zakres i&nbsp;kolejne kroki.</p>
      </div>
    </section>

    <section class="home-section contact-section" id="kontakt" aria-labelledby="contact-title">
      <div class="home-inner contact-grid">
        <div class="contact-details">
          <p class="home-kicker">BEZPOŚREDNI KONTAKT</p>
          <h2 id="contact-title">Krzysztof Krawczyk<br><span>Grafmen</span></h2>
          <a class="contact-email" href="mailto:info@grafmen.com">info@grafmen.com</a>
          <a class="contact-phone" href="tel:+48694179217">+48 694 179 217</a>
          <p>Przemyśl, Podkarpacie.<br>Współpracuję zdalnie z&nbsp;klientami z&nbsp;całej Polski i&nbsp;zagranicy.</p>
          
          <div class="contact-next">
            <h3>Co warto napisać?</h3>
            <ol>
              <li>Czym zajmuje&nbsp;się Twoja firma.</li>
              <li>Jakiego projektu potrzebujesz.</li>
              <li>Czy masz już materiały i&nbsp;orientacyjny termin.</li>
            </ol>
            <p>Nie musisz mieć gotowego briefu. Pomogę uporządkować najważniejsze informacje.</p>
          </div>
        </div>

        <div class="contact-brief">
          <h2>Zapytaj o&nbsp;wycenę</h2>
          <p id="mail-note">Wypełnij krótki brief. Przycisk otworzy Twój program pocztowy z&nbsp;przygotowaną wiadomością. Wyślesz ją samodzielnie z&nbsp;własnej skrzynki.</p>
          <form id="contact-form" action="mailto:info@grafmen.com" method="get" aria-describedby="mail-note">
            <div class="form-row">
              <label>Imię
                <input name="name" autocomplete="given-name" required maxlength="100">
              </label>
              <label>E-mail
                <input name="email" type="email" autocomplete="email" required maxlength="200">
              </label>
            </div>
            <div class="field-group" id="topic-field-group">
              <label id="topic-label" for="contact-topic">Czego dotyczy projekt?</label>
              <div class="custom-select-wrap" id="topic-select-wrap">
                <select name="topic" id="contact-topic" class="native-select">
                  <option value="Strona internetowa" selected>Strona internetowa</option>
                  <option value="Modernizacja strony">Modernizacja strony</option>
                  <option value="Logo i branding">Logo i&nbsp;branding</option>
                  <option value="Materiały firmowe">Materiały firmowe</option>
                  <option value="Inny projekt">Inny projekt</option>
                </select>

                <button
                  type="button"
                  class="custom-select-trigger"
                  id="topic-trigger"
                  aria-haspopup="listbox"
                  aria-expanded="false"
                  aria-labelledby="topic-label topic-value-display"
                  aria-controls="topic-listbox"
                >
                  <span class="custom-select-value" id="topic-value-display">Strona internetowa</span>
                  <span class="custom-select-arrow" aria-hidden="true">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                      <polyline points="6 9 12 15 18 9"></polyline>
                    </svg>
                  </span>
                </button>

                <ul
                  id="topic-listbox"
                  class="custom-select-menu"
                  role="listbox"
                  aria-labelledby="topic-label"
                  tabindex="-1"
                  hidden
                >
                  <li role="option" id="topic-opt-0" class="custom-select-opt is-selected" aria-selected="true" data-value="Strona internetowa" tabindex="-1">
                    <span class="opt-text">Strona internetowa</span>
                    <span class="opt-check" aria-hidden="true">
                      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
                    </span>
                  </li>
                  <li role="option" id="topic-opt-1" class="custom-select-opt" aria-selected="false" data-value="Modernizacja strony" tabindex="-1">
                    <span class="opt-text">Modernizacja strony</span>
                    <span class="opt-check" aria-hidden="true">
                      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
                    </span>
                  </li>
                  <li role="option" id="topic-opt-2" class="custom-select-opt" aria-selected="false" data-value="Logo i branding" tabindex="-1">
                    <span class="opt-text">Logo i&nbsp;branding</span>
                    <span class="opt-check" aria-hidden="true">
                      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
                    </span>
                  </li>
                  <li role="option" id="topic-opt-3" class="custom-select-opt" aria-selected="false" data-value="Materiały firmowe" tabindex="-1">
                    <span class="opt-text">Materiały firmowe</span>
                    <span class="opt-check" aria-hidden="true">
                      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
                    </span>
                  </li>
                  <li role="option" id="topic-opt-4" class="custom-select-opt" aria-selected="false" data-value="Inny projekt" tabindex="-1">
                    <span class="opt-text">Inny projekt</span>
                    <span class="opt-check" aria-hidden="true">
                      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
                    </span>
                  </li>
                </ul>
              </div>
            </div>
            <label>Opisz swój projekt
              <textarea name="message" rows="6" required minlength="10" maxlength="3000" placeholder="Kilka zdań o&nbsp;firmie, zakresie i&nbsp;potrzebach"></textarea>
            </label>
            <p class="form-privacy">Dane posłużą do&nbsp;odpowiedzi na&nbsp;Twoje zapytanie. <a href="/polityka-prywatnosci/">Polityka prywatności</a>.</p>
            <button class="cta-button" type="submit">Wyślij e-mail <span aria-hidden="true">↗</span></button>
            <p id="contact-status" role="status" aria-live="polite"></p>
          </form>
          <noscript>
            <p>Przygotowanie briefu wymaga JavaScript. Napisz bezpośrednio na&nbsp;<a href="mailto:info@grafmen.com">info@grafmen.com</a> lub&nbsp;zadzwoń.</p>
          </noscript>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
