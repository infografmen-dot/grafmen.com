---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import CtaOrange from '../../components/CtaOrange.astro';

const title = "Blog o projektowaniu stron WWW i wizerunku firm | Grafmen";
const description = "Praktycznie o stronach WWW, identyfikacji wizualnej i współpracy z projektantem. Artykuły i porady Krzysztofa Krawczyka z Grafmen.";

const posts = await getCollection('blog', ({ data }) => !data.draft);
const sortedPosts = posts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

function formatDate(date: Date) {
  return date.toLocaleDateString('pl-PL', {
    year: 'numeric',
    month: 'long',
    day: 'numeric'
  });
}
---
<BaseLayout title={title} description={description} currentNav="blog" bodyClass="service-page">
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "CollectionPage",
      "name": title,
      "description": description,
      "url": "https://grafmen.com/blog/"
    })} />
  </Fragment>

  <main id="main-content">
    <section class="service-hero blog-intro-hero">
      <div class="home-inner">
        <p class="home-kicker">BLOG / GRAFMEN</p>
        <h1>O&nbsp;projektowaniu stron<br>i&nbsp;wizerunku firm.</h1>
        <div class="service-hero-bottom">
          <p class="home-lead">Strony WWW, branding i&nbsp;decyzje, które pomagają firmom lepiej się komunikować.</p>
          <div><a class="btn dark" href="/kontakt/">Wyślij zapytanie o&nbsp;wycenę <span>↗</span></a></div>
        </div>
      </div>
    </section>

    <section class="home-section blog-listing-section">
      <div class="home-inner">
        {sortedPosts.length === 1 ? (
          <article class="blog-featured-card">
            <a href={`/blog/${sortedPosts[0].id}/`} class="blog-featured-media" aria-label={sortedPosts[0].data.title}>
              <img src={sortedPosts[0].data.cover} alt={sortedPosts[0].data.coverAlt} loading="lazy" decoding="async" />
            </a>
            <div class="blog-featured-body">
              <div class="blog-featured-meta">
                <span class="blog-featured-cat">{sortedPosts[0].data.category}</span>
                <span class="meta-dot">·</span>
                <time datetime={sortedPosts[0].data.pubDate.toISOString().slice(0, 10)}>{formatDate(sortedPosts[0].data.pubDate)}</time>
              </div>
              <h2 class="blog-featured-title">
                <a href={`/blog/${sortedPosts[0].id}/`}>{sortedPosts[0].data.title}</a>
              </h2>
              <p class="blog-featured-desc">{sortedPosts[0].data.description}</p>
              <div>
                <a href={`/blog/${sortedPosts[0].id}/`} class="blog-featured-link">
                  Czytaj artykuł <span aria-hidden="true">&rarr;</span>
                </a>
              </div>
            </div>
          </article>
        ) : sortedPosts.length > 1 ? (
          <div class="blog-list-grid">
            {sortedPosts.map((post) => (
              <article class="blog-card">
                <a href={`/blog/${post.id}/`} class="blog-card-media" aria-label={post.data.title}>
                  <img src={post.data.cover} alt={post.data.coverAlt} loading="lazy" decoding="async" />
                </a>
                <div class="blog-card-body">
                  <div class="blog-card-meta">
                    <span class="blog-card-cat">{post.data.category}</span>
                    <span class="meta-dot">·</span>
                    <time datetime={post.data.pubDate.toISOString().slice(0, 10)}>{formatDate(post.data.pubDate)}</time>
                  </div>
                  <h3 class="blog-card-title">
                    <a href={`/blog/${post.id}/`}>{post.data.title}</a>
                  </h3>
                  <p class="blog-card-desc">{post.data.description}</p>
                  <a href={`/blog/${post.id}/`} class="blog-card-link">
                    Czytaj artykuł <span aria-hidden="true">&rarr;</span>
                  </a>
                </div>
              </article>
            ))}
          </div>
        ) : (
          <div class="compact-grid">
            <h2>Pierwsze artykuły<br>już wkrótce.</h2>
            <p class="home-lead">Przygotowuję materiały o&nbsp;projektowaniu stron i&nbsp;budowaniu spójnego wizerunku firmy. W&nbsp;międzyczasie zobacz moje <a class="text-link" href="/portfolio/">realizacje ↗</a>.</p>
          </div>
        )}
      </div>
    </section>

    <CtaOrange />
  </main>
</BaseLayout>
