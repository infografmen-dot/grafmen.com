---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import CtaOrange from '../../components/CtaOrange.astro';
import imageManifest from '../../data/image-manifest.json';

export async function getStaticPaths() {
  const orderedSlugs = [
    'drewmax', 'szkola-best', 'hiker', 'drew-art', 'jd-ubezpieczenia',
    'katalog-drew-art', 'montessori', 'piworob', 'katalog-drewmar', 'ja-i-moj-biznes',
    'gazetka-drewmar', 'self-invest', 'unitrans-katalog', 'mpec-przemysl', 'te-solutions',
    'kancelaria-lampa', 'broszura-pervita24', 'gearexpert', 'katalog-targowy-drewmar', 'pobudka'
  ];

  const projects = await getCollection('portfolio');
  const projectMap = new Map(projects.map((p) => [p.data.slug, p]));

  return orderedSlugs.map((slug, idx) => {
    const project = projectMap.get(slug)!;
    const prevSlug = orderedSlugs[(idx - 1 + orderedSlugs.length) % orderedSlugs.length];
    const nextSlug = orderedSlugs[(idx + 1) % orderedSlugs.length];
    const prevProject = projectMap.get(prevSlug)!;
    const nextProject = projectMap.get(nextSlug)!;

    return {
      params: { slug },
      props: {
        project,
        prevProject: { slug: prevProject.data.slug, title: prevProject.data.title },
        nextProject: { slug: nextProject.data.slug, title: nextProject.data.title },
      },
    };
  });
}

const { project, prevProject, nextProject } = Astro.props;
const p = project.data;

const title = `${p.title} | Portfolio`;
const description = p.description;
const coverSrc = p.cover.startsWith('/') ? p.cover : `/${p.cover}`;
const ogImage = `https://grafmen.com${coverSrc}`;

function fixOrphans(text: string): string {
  if (!text) return text;
  let prev = '';
  let result = text;
  while (result !== prev) {
    prev = result;
    result = result.replace(/(^|[\s(„"'\u00A0])([a-zA-ZąćęłńóśźżĄĆĘŁŃÓŚŹŻ])\s+/g, '$1$2\u00A0');
  }
  return result;
}

function getImageInfo(src: string) {
  if (!src) return null;
  const clean = src.startsWith('/') ? src.slice(1) : src;
  const manifest = imageManifest as Record<string, any>;
  return manifest[clean] || null;
}

const coverInfo = getImageInfo(p.cover);
const coverWidth = coverInfo?.width || 1400;
const coverHeight = coverInfo?.height || 920;
const coverSrcset = coverInfo?.srcset || '';
---
<BaseLayout title={title} description={description} currentNav="work" bodyClass="service-page" ogImage={ogImage}>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "CreativeWork",
      "name": p.title,
      "description": p.description,
      "url": `https://grafmen.com/portfolio/${p.slug}/`,
      "image": `https://grafmen.com${coverSrc}`,
      "creator": {
        "@type": "Person",
        "name": "Krzysztof Krawczyk"
      }
    })} />
  </Fragment>

  <main id="main-content">
    <article class="project-detail">
      <!-- 1. HEADER & BREADCRUMBS -->
      <section class="project-heading home-inner">
        <nav class="breadcrumbs" aria-label="Okruszki">
          <a href="/portfolio/">Portfolio</a> / <span aria-current="page">{p.title}</span>
        </nav>
        <p class="home-kicker">{p.category}{p.year ? ` / ${p.year}` : ''}</p>
        <h1>{fixOrphans(p.title)}</h1>
        <p class="home-lead">{fixOrphans(p.description)}</p>
      </section>

      <!-- 2. GŁÓWNE ZDJĘCIE (COVER) -->
      <figure class="project-cover home-inner">
        <img
          src={coverSrc}
          srcset={coverSrcset || undefined}
          sizes="(max-width: 640px) 100vw, (max-width: 1024px) 92vw, 1400px"
          alt={p.cover_alt}
          width={coverWidth}
          height={coverHeight}
          fetchpriority="high"
          decoding="async"
        />
      </figure>

      <!-- 3. POTRZEBA -->
      <section class="home-section">
        <div class="home-inner compact-grid">
          <div>
            <p class="home-kicker">POTRZEBA</p>
            <h2>{fixOrphans(p.brief_title)}</h2>
          </div>
          <div class="bio-copy">
            {p.brief.map((paragraph) => (
              <p>{fixOrphans(paragraph)}</p>
            ))}
          </div>
        </div>
      </section>

      <!-- 4. ZAKRES -->
      <section class="home-section project-scope">
        <div class="home-inner compact-grid">
          <div>
            <p class="home-kicker">ZAKRES</p>
            <h2>Co zrobiłem</h2>
          </div>
          <ul class="scope-list">
            {p.deliverables.map((item) => (
              <li>{fixOrphans(item)}</li>
            ))}
          </ul>
        </div>
      </section>

      <!-- 5. PROJEKT W ZASTOSOWANIU (GALERIA) -->
      {p.gallery && p.gallery.length > 0 && (
        <section class="home-section project-gallery-section" id={p.slug === 'hiker' ? 'branding' : undefined}>
          <div class="home-inner">
            <p class="home-kicker">{p.slug === 'hiker' ? 'BRANDING' : 'REALIZACJA'}</p>
            <h2>{p.slug === 'hiker' ? 'Identyfikacja wizualna i ruch' : 'Projekt w zastosowaniu'}</h2>
            <div class="project-gallery">
              {p.gallery.map((item) => {
                const itemSrc = item.src.startsWith('/') ? item.src : `/${item.src}`;
                const itemInfo = getImageInfo(item.src);
                const itemWidth = itemInfo?.width || item.width || 1400;
                const itemHeight = itemInfo?.height || item.height || 920;
                const itemSrcset = itemInfo?.srcset || '';
                const isVertical = Boolean(itemInfo?.isVertical ?? (itemHeight && itemWidth && (itemHeight / itemWidth >= 1.25)));

                if (item.type === 'video') {
                  const posterSrc = item.poster ? (item.poster.startsWith('/') ? item.poster : `/${item.poster}`) : undefined;
                  return (
                    <figure class={isVertical ? 'gallery-item-vertical' : undefined}>
                      <video
                        class={p.slug === 'hiker' ? 'scroll-autoplay-video' : undefined}
                        src={itemSrc}
                        poster={posterSrc}
                        width={item.width || 1920}
                        height={item.height || 1080}
                        controls
                        playsinline
                        muted
                        preload="metadata"
                        style="width:100%;height:auto;border-radius:16px;display:block;background:#09090b"
                      ></video>
                      {item.caption && <figcaption>{fixOrphans(item.caption)}</figcaption>}
                    </figure>
                  );
                }
                return (
                  <figure class={isVertical ? 'gallery-item-vertical' : undefined}>
                    <img
                      src={itemSrc}
                      srcset={itemSrcset || undefined}
                      sizes={isVertical ? "(max-width: 640px) 100vw, 640px" : "(max-width: 640px) 100vw, (max-width: 1024px) 92vw, 1400px"}
                      alt={item.alt}
                      loading="lazy"
                      decoding="async"
                      width={itemWidth}
                      height={itemHeight}
                    />
                    {item.caption && <figcaption>{fixOrphans(item.caption)}</figcaption>}
                  </figure>
                );
              })}
            </div>
          </div>
        </section>
      )}

      <!-- 6. OPCJONALNY FILM (HIKER) -->
      {p.slug === 'hiker' && (
        <section class="home-section project-film-section" id="film">
          <div class="home-inner compact-grid">
            <div>
              <p class="home-kicker">FILM REKLAMOWY</p>
              <h2>Film promocyjny Hiker</h2>
            </div>
            <div class="bio-copy">
              <p>Film reklamowy prezentujący markę Hiker w&nbsp;otoczeniu gór i&nbsp;surowej przyrody. Dynamiczne ujęcia plenerowe, gra światła i&nbsp;otwarta przestrzeń budują autentyczny klimat marki outdoorowej.</p>
              <p style="margin-top:24px">
                <a class="cta-button" href="https://www.youtube.com/watch?v=WOaOxbPIIhs" target="_blank" rel="noopener noreferrer">
                  Obejrzyj film na YouTube <span aria-hidden="true">↗</span>
                </a>
              </p>
            </div>
          </div>
          <div class="home-inner project-film-media" style="margin-top:36px">
            <figure>
              <div
                class="youtube-facade"
                id="hiker-youtube-player"
                data-video-id="WOaOxbPIIhs"
                data-title="Film promocyjny Hiker"
              >
                <button
                  type="button"
                  class="youtube-facade-btn"
                  aria-label="Odtwórz film promocyjny Hiker"
                >
                  <img
                    src="/assets/motion/hiker-film-poster.webp"
                    alt="Film promocyjny Hiker · miniatura filmu"
                    width="1920"
                    height="1080"
                    loading="lazy"
                    decoding="async"
                    class="youtube-facade-thumb"
                  />
                  <span class="youtube-facade-play" aria-hidden="true">
                    <svg viewBox="0 0 68 48" width="68" height="48" aria-hidden="true">
                      <path class="yt-play-bg" d="M66.52 7.74c-.78-2.93-2.49-5.41-5.42-6.19C55.79.13 34 0 34 0S12.21.13 6.9 1.55c-2.93.78-4.63 3.26-5.42 6.19C.06 13.05 0 24 0 24s.06 10.95 1.48 16.26c.78 2.93 2.49 5.41 5.42 6.19C12.21 47.87 34 48 34 48s21.79-.13 27.1-1.55c2.93-.78 4.64-3.26 5.42-6.19C67.94 34.95 68 24 68 24s-.06-10.95-1.48-16.26z" fill="#212121" fill-opacity="0.85"></path>
                      <path d="M45 24 27 14v20z" fill="#ffffff"></path>
                    </svg>
                  </span>
                </button>
              </div>
              <figcaption style="margin-top:12px;font-size:14px;color:#62626b">Film reklamowy marki Hiker · ujęcia w&nbsp;górskiej scenerii.</figcaption>
            </figure>
          </div>
        </section>
      )}

      <!-- 7. REZULTAT -->
      <section class="home-section">
        <div class="home-inner compact-grid">
          <div>
            <p class="home-kicker">REZULTAT</p>
            <h2>{fixOrphans(p.result_title)}</h2>
          </div>
          <div class="bio-copy">
            {p.result.map((paragraph) => (
              <p>{fixOrphans(paragraph)}</p>
            ))}
            {p.testimonial && (
              <article class="testimonial-card" style="margin-top:28px">
                <blockquote>
                  <p>{fixOrphans(p.testimonial)}</p>
                </blockquote>
                {p.testimonial_author && (
                  <footer>
                    <strong>{p.testimonial_author}</strong>
                  </footer>
                )}
              </article>
            )}
            {p.external_url && (
              <p style="margin-top:24px">
                <a class="text-link" href={p.external_url} target="_blank" rel="noopener noreferrer">
                  {p.external_label || 'Otwórz stronę'} <span aria-hidden="true">&nearr;</span>
                </a>
              </p>
            )}
          </div>
        </div>
      </section>

      <!-- 8. NAWIGACJA MIĘDZY REALIZACJAMI -->
      <section class="project-next home-inner" aria-label="Nawigacja między realizacjami">
        <a class="text-link" href={`/portfolio/${prevProject.slug}/`} rel="prev">
          <span aria-hidden="true">&larr;</span> Poprzedni: {prevProject.title}
        </a>
        <a class="text-link" href="/portfolio/">Wszystkie realizacje</a>
        <a class="text-link" href={`/portfolio/${nextProject.slug}/`} rel="next">
          Następny: {nextProject.title} <span aria-hidden="true">&rarr;</span>
        </a>
      </section>
    </article>

    <!-- 9. WSPÓLNE POMARAŃCZOWE CTA -->
    <CtaOrange />
  </main>

  <script is:inline>
    document.addEventListener('DOMContentLoaded', function() {
      // YouTube lazy facade
      var ytFacades = document.querySelectorAll('.youtube-facade');
      ytFacades.forEach(function(facade) {
        var btn = facade.querySelector('.youtube-facade-btn');
        if (!btn) return;
        btn.addEventListener('click', function() {
          var videoId = facade.getAttribute('data-video-id');
          var title = facade.getAttribute('data-title') || 'Wideo';
          if (!videoId) return;

          var iframe = document.createElement('iframe');
          iframe.setAttribute('src', 'https://www.youtube-nocookie.com/embed/' + encodeURIComponent(videoId) + '?autoplay=1&rel=0');
          iframe.setAttribute('title', title);
          iframe.setAttribute('frameborder', '0');
          iframe.setAttribute('allow', 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share');
          iframe.setAttribute('allowfullscreen', 'true');
          iframe.className = 'youtube-facade-iframe';

          facade.innerHTML = '';
          facade.appendChild(iframe);
          facade.classList.add('is-playing');
        });
      });

      // Scroll-triggered autoplay for videos with controls (respecting prefers-reduced-motion)
      var prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (!prefersReducedMotion) {
        var scrollVideos = document.querySelectorAll('video.scroll-autoplay-video');
        if (scrollVideos.length > 0 && 'IntersectionObserver' in window) {
          var videoObserver = new IntersectionObserver(function(entries) {
            entries.forEach(function(entry) {
              var video = entry.target;
              if (entry.isIntersecting) {
                var playPromise = video.play();
                if (playPromise !== undefined) {
                  playPromise.catch(function() {});
                }
              }
            });
          }, { threshold: 0.3 });

          scrollVideos.forEach(function(v) {
            videoObserver.observe(v);
          });
        }
      }
    });
  </script>
</BaseLayout>
