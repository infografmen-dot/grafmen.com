---
import BaseLayout from '../layouts/BaseLayout.astro';
import PortfolioGrid from '../components/PortfolioGrid.astro';
import WspolpracaCards from '../components/WspolpracaCards.astro';
import ClientLogos from '../components/ClientLogos.astro';
import OpinieGrid from '../components/OpinieGrid.astro';
import FaqAccordion from '../components/FaqAccordion.astro';
import CtaOrange from '../components/CtaOrange.astro';

const title = "Strony WWW, branding i grafika dla firm | Grafmen";
const description = "Projektuję strony WWW, branding, materiały reklamowe i motion dla firm. Grafmen od 2005 roku. Projekty dla firm z Przemyśla, Podkarpacia i całej Polski.";
---
<BaseLayout title={title} description={description} currentNav="home" bodyClass="home-page">
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": ["ProfessionalService", "LocalBusiness"],
      "@id": "https://grafmen.com/#business",
      "name": "Grafmen · Krzysztof Krawczyk",
      "url": "https://grafmen.com/",
      "description": "Strony WWW, branding, grafika reklamowa i motion dla firm.",
      "foundingDate": "2005",
      "areaServed": ["Przemyśl", "Podkarpacie", "Polska"],
      "sameAs": [
        "https://www.facebook.com/grafmen",
        "https://www.instagram.com/grafmen",
        "https://www.linkedin.com/in/krzysztof-krawczyk-grafmen"
      ]
    })} />
  </Fragment>

  <main id="main-content">
    <div class="wrap">
      <!-- 1. HERO -->
      <section class="hero" id="hero-section">
        <!-- Static cube background (left + fallback for all breakpoints) -->
        <div class="cube-field" aria-hidden="true"></div>
        <!-- Animated cubes video – right side decoration, desktop only -->
        <div class="hero-cubes-video" aria-hidden="true" id="hero-cubes-wrap">
          <video
            id="hero-cubes-vid"
            class="hero-cubes-vid"
            poster="/assets/motion/hero-cubes-poster.webp"
            muted
            playsinline
            loop
            preload="none"
            tabindex="-1"
            aria-hidden="true"
          ></video>
        </div>
        <!-- Pause/resume button for motion accessibility -->
        <button
          class="hero-cubes-pause"
          id="hero-cubes-pause"
          type="button"
          aria-label="Wstrzymaj animację"
          aria-pressed="false"
          hidden
        >
          <svg aria-hidden="true" focusable="false" width="14" height="14" viewBox="0 0 14 14" fill="currentColor">
            <rect x="2" y="1" width="3.5" height="12" rx="1"/>
            <rect x="8.5" y="1" width="3.5" height="12" rx="1"/>
          </svg>
        </button>
        <div class="eyebrow"><span>Przemyśl, Polska</span><span class="dot">●</span><span>od&nbsp;2005</span></div>
        <div class="hero-grid">
          <div>
            <h1>
              <span class="hero-line" data-line="0"><span class="hero-line-inner">Ty zajmujesz się</span><span class="hero-wipe-brand" aria-hidden="true"></span><span class="hero-wipe-fg" aria-hidden="true"></span></span><br>
              <span class="hero-line" data-line="1"><span class="hero-line-inner"><span class="uword"><span class="uword-mob">swo</span>ją</span> firmą.</span><span class="hero-wipe-brand" aria-hidden="true"></span><span class="hero-wipe-fg" aria-hidden="true"></span></span><br>
              <span class="hero-line" data-line="2"><span class="hero-line-inner">Ja dbam o&nbsp;to,</span><span class="hero-wipe-brand" aria-hidden="true"></span><span class="hero-wipe-fg" aria-hidden="true"></span></span><br>
              <span class="hero-line" data-line="3"><span class="hero-line-inner">jak ją widać<span class="terminal" aria-hidden="true"></span></span><span class="hero-wipe-brand" aria-hidden="true"></span><span class="hero-wipe-fg" aria-hidden="true"></span></span>
            </h1>
            <p class="lead">Projektuję strony WWW, branding, materiały reklamowe i&nbsp;motion dla&nbsp;firm.<br>Od&nbsp;koncepcji i&nbsp;treści po&nbsp;gotowy projekt i&nbsp;wdrożenie.</p>
            <div class="actions"><a class="btn dark" href="/kontakt/">Zapytaj o&nbsp;wycenę <span>&rarr;</span></a></div>
          </div>
          <aside class="meta01"><div class="meta01-top"></div>STRONY WWW<br>BRANDING<br>MOTION</aside>
        </div>
        <div class="hero-bottom">
          <div class="mini">LEPSZE STRONY<br>DLA&nbsp;AMBITNYCH FIRM</div>
          <div class="center"><span class="mouse"></span><span>PRZEWIŃ W&nbsp;DÓŁ</span><span class="arrowdown">&darr;</span></div>
          <div class="mini right">EST. 2005<br>PRZEMYŚL, POLSKA</div>
        </div>
      </section>

      <script>
      (function () {
        'use strict';
        // Only run on desktop-width (min 1200px) and respect accessibility preferences
        const MIN_WIDTH = 1200;
        function shouldRun() {
          if (typeof window === 'undefined') return false;
          if (window.innerWidth < MIN_WIDTH) return false;
          if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return false;
          // @ts-ignore
          if (navigator.connection && navigator.connection.saveData) return false;
          return true;
        }

        if (!shouldRun()) return;

        const vid = /** @type {HTMLVideoElement} */ (document.getElementById('hero-cubes-vid'));
        const wrap = document.getElementById('hero-cubes-wrap');
        const btn = /** @type {HTMLButtonElement} */ (document.getElementById('hero-cubes-pause'));
        if (!vid || !wrap || !btn) return;

        // Lazy-load sources only after confirming conditions
        const webmSrc = document.createElement('source');
        webmSrc.type = 'video/webm';
        webmSrc.src = '/assets/motion/hero-cubes.webm';
        const mp4Src = document.createElement('source');
        mp4Src.type = 'video/mp4';
        mp4Src.src = '/assets/motion/hero-cubes.mp4';
        vid.appendChild(webmSrc);
        vid.appendChild(mp4Src);
        // Ensure muted and set slow playback rate before loading
        vid.muted = true;
        vid.defaultPlaybackRate = 0.4;
        vid.playbackRate = 0.4;
        vid.load();

        // Show pause button and mark hero as video-active on first play
        vid.addEventListener('playing', function onPlaying() {
          btn.hidden = false;
          const heroSection = document.getElementById('hero-section');
          if (heroSection) heroSection.classList.add('has-hero-video');
          vid.removeEventListener('playing', onPlaying);
        }, { once: true });

        // Fallback: keep poster if video fails
        vid.addEventListener('error', function () {
          btn.hidden = true;
          if (wrap) wrap.style.display = 'none';
        });

        let paused = false;
        // Pause/resume button toggle
        btn.addEventListener('click', function () {
          paused = !paused;
          if (paused) {
            vid.pause();
            btn.setAttribute('aria-label', 'Wznów animację');
            btn.setAttribute('aria-pressed', 'true');
            btn.querySelector('svg')?.replaceWith(makeSvgPlay());
          } else {
            vid.playbackRate = 0.4;
            vid.play().catch(() => {});
            btn.setAttribute('aria-label', 'Wstrzymaj animację');
            btn.setAttribute('aria-pressed', 'false');
            btn.querySelector('svg')?.replaceWith(makeSvgPause());
          }
        });

        function makeSvgPause() {
          const s = document.createElementNS('http://www.w3.org/2000/svg', 'svg');
          s.setAttribute('aria-hidden', 'true');
          s.setAttribute('focusable', 'false');
          s.setAttribute('width', '14');
          s.setAttribute('height', '14');
          s.setAttribute('viewBox', '0 0 14 14');
          s.setAttribute('fill', 'currentColor');
          s.innerHTML = '<rect x="2" y="1" width="3.5" height="12" rx="1"/><rect x="8.5" y="1" width="3.5" height="12" rx="1"/>';
          return s;
        }
        function makeSvgPlay() {
          const s = document.createElementNS('http://www.w3.org/2000/svg', 'svg');
          s.setAttribute('aria-hidden', 'true');
          s.setAttribute('focusable', 'false');
          s.setAttribute('width', '14');
          s.setAttribute('height', '14');
          s.setAttribute('viewBox', '0 0 14 14');
          s.setAttribute('fill', 'currentColor');
          s.innerHTML = '<path d="M3 1.5l9 5.5-9 5.5V1.5z"/>';
          return s;
        }

        // Pause when hero leaves viewport (IntersectionObserver)
        if ('IntersectionObserver' in window) {
          const io = new IntersectionObserver(function (entries) {
            entries.forEach(function (entry) {
              if (!paused) {
                if (entry.isIntersecting) {
                  vid.playbackRate = 0.4;
                  vid.play().catch(() => {});
                } else {
                  vid.pause();
                }
              }
            });
          }, { threshold: 0.1 });
          const hero = document.getElementById('hero-section');
          if (hero) io.observe(hero);
        }

        // Pause when tab is hidden
        document.addEventListener('visibilitychange', function () {
          if (!paused) {
            if (document.hidden) {
              vid.pause();
            } else {
              vid.playbackRate = 0.4;
              vid.play().catch(() => {});
            }
          }
        });
      })();
      </script>

      <!-- 2. PORTFOLIO (6 REALIZACJI) -->
      <PortfolioGrid />
    </div>

    <!-- 3. WSPÓŁPRACA (2 KAFLE DREWMAX & HIKER) -->
    <WspolpracaCards />

    <!-- 4. LOGOTYPY KLIENTÓW (ZWARTY PAS) -->
    <ClientLogos />

    <!-- 5. OPINIE KLIENTÓW (3 OPINIE) -->
    <OpinieGrid />

    <!-- 6. FAQ (4 PYTANIA) -->
    <FaqAccordion />

    <!-- 7. POMARAŃCZOWE CTA -->
    <CtaOrange />
  </main>
</BaseLayout>
