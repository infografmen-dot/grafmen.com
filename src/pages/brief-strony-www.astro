---
import BaseLayout from '../layouts/BaseLayout.astro';

const title = "Brief strony internetowej · wycena i założenia projektu | Grafmen";
const description = "Wypełnij krótki, 3-krokowy brief strony internetowej. Określ cele, funkcje i zakres witryny. Na podstawie odpowiedzi przygotuję wycenę i harmonogram.";
---
<BaseLayout title={title} description={description} bodyClass="service-page" canonicalPath="/brief-strony-www/">
  <Fragment slot="head">
    <link rel="stylesheet" href="/brief.css" />
    <script src="/web3forms-client.js" defer></script>
    <script src="/brief-stepper.js" defer></script>
  </Fragment>

  <main id="main-content">
    <div class="home-inner brief-page-wrap">
      <div class="brief-container">
        
        <!-- Wprowadzenie: pionowy układ, wyrównany do lewej, bez kolizji z headerem globalnym -->
        <div class="brief-intro-block">
          <p class="brief-intro-kicker">BRIEF / STRONY WWW</p>
          <h1 class="brief-intro-title">Opowiedz mi o swojej stronie.</h1>
          <p class="brief-intro-lead">Odpowiedz na kilka pytań. Pomogą mi przygotować zakres prac i wycenę.</p>
        </div>

        <!-- Wskaźnik postępu (stepper) -->
        <div class="brief-stepper" aria-label="Postęp wypełniania briefu">
          <div class="stepper-header">
            <span class="stepper-step-indicator" id="stepper-step-indicator">Krok 1 z 3</span>
            <span class="stepper-step-title" id="stepper-step-title">Projekt i firma</span>
          </div>
          <div class="stepper-progress-track" role="progressbar" aria-valuenow="33" aria-valuemin="0" aria-valuemax="100">
            <div class="stepper-progress-bar" id="stepper-progress-bar" style="width: 33%;"></div>
          </div>
        </div>

        <!-- Główny formularz (białe tło, delikatne obramowanie, semantyczny fieldset) -->
        <div class="brief-card-box">
          <form id="brief-form" data-brief-type="web" novalidate>
            <!-- Honeypot antyspamowy -->
            <input type="checkbox" name="botcheck" class="botcheck-field" tabindex="-1" autocomplete="off" style="display:none !important">

            <!-- KROK 1: Projekt i firma -->
            <fieldset class="brief-step is-active" data-step="0">
              <legend class="step-legend">Krok 1: O projekcie i firmie</legend>
              <p class="step-desc">Podstawowe informacje pozwolą dopasować strukturę i charakter witryny.</p>

              <div class="brief-group">
                <label class="brief-label">Rodzaj projektu <span class="req" aria-hidden="true">*</span></label>
                <div class="tiles-grid is-3" role="radiogroup" aria-required="true">
                  <label class="tile-choice">
                    <input type="radio" name="project_type" value="Nowa strona internetowa" class="tile-input">
                    <span class="tile-body">
                      <span class="tile-indicator" aria-hidden="true"></span>
                      <span class="tile-label-wrap">
                        <span class="tile-title">Nowa strona internetowa</span>
                        <span class="tile-desc">Projekt od podstaw dla nowej działalności</span>
                      </span>
                    </span>
                  </label>

                  <label class="tile-choice">
                    <input type="radio" name="project_type" value="Modernizacja obecnej strony" class="tile-input">
                    <span class="tile-body">
                      <span class="tile-indicator" aria-hidden="true"></span>
                      <span class="tile-label-wrap">
                        <span class="tile-title">Modernizacja obecnej strony</span>
                        <span class="tile-desc">Przebudowa wyglądu i technologii</span>
                      </span>
                    </span>
                  </label>

                  <label class="tile-choice">
                    <input type="radio" name="project_type" value="Potrzebuję pomocy w określeniu" class="tile-input">
                    <span class="tile-body">
                      <span class="tile-indicator" aria-hidden="true"></span>
                      <span class="tile-label-wrap">
                        <span class="tile-title">Potrzebuję pomocy</span>
                        <span class="tile-desc">Wspólnie ustalimy optymalny kierunek</span>
                      </span>
                    </span>
                  </label>
                </div>
              </div>

              <div class="brief-group">
                <label class="brief-label" for="company-overview">Czym zajmuje się Twoja firma i dla kogo pracuje? <span class="req" aria-hidden="true">*</span></label>
                <textarea id="company-overview" name="company_overview" class="brief-textarea" rows="3" required placeholder="np. Produkujemy meble na wymiar dla klientów indywidualnych i biur na terenie Podkarpacia."></textarea>
              </div>

              <div class="brief-group">
                <label class="brief-label">Główny cel strony internetowej</label>
                <div class="tiles-grid" role="radiogroup">
                  <label class="tile-choice">
                    <input type="radio" name="primary_goal" value="Pozyskiwanie zapytań i klientów" class="tile-input">
                    <span class="tile-body">
                      <span class="tile-indicator" aria-hidden="true"></span>
                      <span class="tile-label-wrap">
                        <span class="tile-title">Pozyskiwanie zapytań</span>
                        <span class="tile-desc">Zachęcenie do kontaktu lub wyceny</span>
                      </span>
                    </span>
                  </label>

                  <label class="tile-choice">
                    <input type="radio" name="primary_goal" value="Prezentacja oferty i wizerunku" class="tile-input">
                    <span class="tile-body">
                      <span class="tile-indicator" aria-hidden="true"></span>
                      <span class="tile-label-wrap">
                        <span class="tile-title">Wizerunek i oferta</span>
                        <span class="tile-desc">Przejrzysta wizytówka budująca zaufanie</span>
                      </span>
                    </span>
                  </label>

                  <label class="tile-choice">
                    <input type="radio" name="primary_goal" value="Sprzedaż produktów lub usług online" class="tile-input">
                    <span class="tile-body">
                      <span class="tile-indicator" aria-hidden="true"></span>
                      <span class="tile-label-wrap">
                        <span class="tile-title">Sprzedaż online</span>
                        <span class="tile-desc">Katalog produktów z opcją zamówienia</span>
                      </span>
                    </span>
                  </label>

                  <label class="tile-choice">
                    <input type="radio" name="primary_goal" value="Inny cel" class="tile-input">
                    <span class="tile-body">
                      <span class="tile-indicator" aria-hidden="true"></span>
                      <span class="tile-label-wrap">
                        <span class="tile-title">Inny cel</span>
                        <span class="tile-desc">Wymagania niestandardowe lub branżowe</span>
                      </span>
                    </span>
                  </label>
                </div>
              </div>
            </fieldset>

            <!-- KROK 2: Funkcje i materiały -->
            <fieldset class="brief-step" data-step="1" aria-hidden="true">
              <legend class="step-legend">Krok 2: Potrzebne funkcje i materiały</legend>
              <p class="step-desc">Zaznacz elementy, które powinny znaleźć się w projekcie.</p>

              <div class="brief-group">
                <label class="brief-label">Potrzebne funkcje na stronie</label>
                <p class="brief-hint">Wstępne rozeznanie potrzeb – zakres doprecyzujemy w wycenie.</p>
                <div class="tiles-grid">
                  <label class="tile-choice is-checkbox">
                    <input type="checkbox" name="features" value="Prezentacja oferty i usług" class="tile-input">
                    <span class="tile-body">
                      <span class="tile-indicator" aria-hidden="true"><svg class="tile-check-icon" viewBox="0 0 24 24" fill="none"><polyline points="20 6 9 17 4 12"></polyline></svg></span>
                      <span class="tile-title">Prezentacja oferty</span>
                    </span>
                  </label>

                  <label class="tile-choice is-checkbox">
                    <input type="checkbox" name="features" value="Portfolio / realizacje" class="tile-input">
                    <span class="tile-body">
                      <span class="tile-indicator" aria-hidden="true"><svg class="tile-check-icon" viewBox="0 0 24 24" fill="none"><polyline points="20 6 9 17 4 12"></polyline></svg></span>
                      <span class="tile-title">Portfolio / realizacje</span>
                    </span>
                  </label>

                  <label class="tile-choice is-checkbox">
                    <input type="checkbox" name="features" value="Blog / aktualności" class="tile-input">
                    <span class="tile-body">
                      <span class="tile-indicator" aria-hidden="true"><svg class="tile-check-icon" viewBox="0 0 24 24" fill="none"><polyline points="20 6 9 17 4 12"></polyline></svg></span>
                      <span class="tile-title">Blog / aktualności</span>
                    </span>
                  </label>

                  <label class="tile-choice is-checkbox">
                    <input type="checkbox" name="features" value="Sklep internetowy" class="tile-input">
                    <span class="tile-body">
                      <span class="tile-indicator" aria-hidden="true"><svg class="tile-check-icon" viewBox="0 0 24 24" fill="none"><polyline points="20 6 9 17 4 12"></polyline></svg></span>
                      <span class="tile-title">Sklep internetowy</span>
                    </span>
                  </label>

                  <label class="tile-choice is-checkbox">
                    <input type="checkbox" name="features" value="Rezerwacje / kalendarz" class="tile-input">
                    <span class="tile-body">
                      <span class="tile-indicator" aria-hidden="true"><svg class="tile-check-icon" viewBox="0 0 24 24" fill="none"><polyline points="20 6 9 17 4 12"></polyline></svg></span>
                      <span class="tile-title">Rezerwacje / kalendarz</span>
                    </span>
                  </label>

                  <label class="tile-choice is-checkbox">
                    <input type="checkbox" name="features" value="Wersje językowe (np. EN)" class="tile-input">
                    <span class="tile-body">
                      <span class="tile-indicator" aria-hidden="true"><svg class="tile-check-icon" viewBox="0 0 24 24" fill="none"><polyline points="20 6 9 17 4 12"></polyline></svg></span>
                      <span class="tile-title">Wersje językowe (np. EN)</span>
                    </span>
                  </label>
                </div>
              </div>

              <div class="brief-group">
                <label class="brief-label">Posiadane materiały wyjściowe</label>
                <div class="tiles-grid">
                  <label class="tile-choice is-checkbox">
                    <input type="checkbox" name="assets" value="Logo / identyfikacja wizualna" class="tile-input">
                    <span class="tile-body">
                      <span class="tile-indicator" aria-hidden="true"><svg class="tile-check-icon" viewBox="0 0 24 24" fill="none"><polyline points="20 6 9 17 4 12"></polyline></svg></span>
                      <span class="tile-title">Logo / branding</span>
                    </span>
                  </label>

                  <label class="tile-choice is-checkbox">
                    <input type="checkbox" name="assets" value="Gotowe teksty na stronę" class="tile-input">
                    <span class="tile-body">
                      <span class="tile-indicator" aria-hidden="true"><svg class="tile-check-icon" viewBox="0 0 24 24" fill="none"><polyline points="20 6 9 17 4 12"></polyline></svg></span>
                      <span class="tile-title">Teksty na stronę</span>
                    </span>
                  </label>

                  <label class="tile-choice is-checkbox">
                    <input type="checkbox" name="assets" value="Zdjęcia i grafiki" class="tile-input">
                    <span class="tile-body">
                      <span class="tile-indicator" aria-hidden="true"><svg class="tile-check-icon" viewBox="0 0 24 24" fill="none"><polyline points="20 6 9 17 4 12"></polyline></svg></span>
                      <span class="tile-title">Zdjęcia i grafiki</span>
                    </span>
                  </label>

                  <label class="tile-choice is-checkbox">
                    <input type="checkbox" name="assets" value="Potrzebuję pomocy w przygotowaniu materiałów" class="tile-input">
                    <span class="tile-body">
                      <span class="tile-indicator" aria-hidden="true"><svg class="tile-check-icon" viewBox="0 0 24 24" fill="none"><polyline points="20 6 9 17 4 12"></polyline></svg></span>
                      <span class="tile-title">Potrzebuję pomocy</span>
                    </span>
                  </label>
                </div>
              </div>

              <div class="brief-group">
                <label class="brief-label" for="web-references">Adres obecnej strony lub inspiracje (opcjonalnie)</label>
                <input type="text" id="web-references" name="references" class="brief-input" placeholder="np. https://mojastrona.pl lub linki do stron, które Ci się podobają">
              </div>
            </fieldset>

            <!-- KROK 3: Harmonogram, budżet i kontakt -->
            <fieldset class="brief-step" data-step="2" aria-hidden="true">
              <legend class="step-legend">Krok 3: Harmonogram, budżet i kontakt</legend>
              <p class="step-desc">Określ ramy czasowe oraz dane do przygotowania wyceny.</p>

              <div class="brief-group">
                <label class="brief-label">Orientacyjny termin realizacji</label>
                <div class="tiles-grid" role="radiogroup">
                  <label class="tile-choice">
                    <input type="radio" name="timeline" value="Jak najszybciej (1–2 tygodnie)" class="tile-input">
                    <span class="tile-body">
                      <span class="tile-indicator" aria-hidden="true"></span>
                      <span class="tile-title">Jak najszybciej (1–2 tyg.)</span>
                    </span>
                  </label>

                  <label class="tile-choice">
                    <input type="radio" name="timeline" value="W ciągu miesiąca" class="tile-input">
                    <span class="tile-body">
                      <span class="tile-indicator" aria-hidden="true"></span>
                      <span class="tile-title">W ciągu miesiąca</span>
                    </span>
                  </label>

                  <label class="tile-choice">
                    <input type="radio" name="timeline" value="W ciągu 2–3 miesięcy" class="tile-input">
                    <span class="tile-body">
                      <span class="tile-indicator" aria-hidden="true"></span>
                      <span class="tile-title">W ciągu 2–3 miesięcy</span>
                    </span>
                  </label>

                  <label class="tile-choice">
                    <input type="radio" name="timeline" value="Elastyczny termin" class="tile-input">
                    <span class="tile-body">
                      <span class="tile-indicator" aria-hidden="true"></span>
                      <span class="tile-title">Elastyczny termin</span>
                    </span>
                  </label>
                </div>
              </div>

              <div class="brief-group">
                <label class="brief-label">Orientacyjny budżet na stronę</label>
                <div class="tiles-grid" role="radiogroup">
                  <label class="tile-choice">
                    <input type="radio" name="budget" value="1 500 – 3 000 zł" class="tile-input">
                    <span class="tile-body">
                      <span class="tile-indicator" aria-hidden="true"></span>
                      <span class="tile-title">1 500 – 3 000 zł</span>
                    </span>
                  </label>

                  <label class="tile-choice">
                    <input type="radio" name="budget" value="3 000 – 6 000 zł" class="tile-input">
                    <span class="tile-body">
                      <span class="tile-indicator" aria-hidden="true"></span>
                      <span class="tile-title">3 000 – 6 000 zł</span>
                    </span>
                  </label>

                  <label class="tile-choice">
                    <input type="radio" name="budget" value="Powyżej 6 000 zł" class="tile-input">
                    <span class="tile-body">
                      <span class="tile-indicator" aria-hidden="true"></span>
                      <span class="tile-title">Powyżej 6 000 zł</span>
                    </span>
                  </label>

                  <label class="tile-choice">
                    <input type="radio" name="budget" value="Do ustalenia po wycenie" class="tile-input">
                    <span class="tile-body">
                      <span class="tile-indicator" aria-hidden="true"></span>
                      <span class="tile-title">Do ustalenia po wycenie</span>
                    </span>
                  </label>
                </div>
              </div>

              <div class="brief-group">
                <label class="brief-label" for="contact-name">Imię lub osoba kontaktowa <span class="req" aria-hidden="true">*</span></label>
                <input type="text" id="contact-name" name="contact_name" class="brief-input" required autocomplete="name" placeholder="np. Jan Kowalski">
              </div>

              <div class="brief-group">
                <label class="brief-label" for="contact-email">Adres e-mail do odpowiedzi <span class="req" aria-hidden="true">*</span></label>
                <input type="email" id="contact-email" name="contact_email" class="brief-input" required autocomplete="email" placeholder="np. jan@twojafirma.pl">
                
                <div class="phone-toggle-wrap">
                  <button type="button" class="phone-toggle-btn" id="toggle-phone-btn" aria-expanded="false">
                    <span>+ Dodaj numer telefonu (opcjonalnie)</span>
                  </button>
                  <div class="phone-field-box" id="phone-field-box" hidden>
                    <label class="brief-label" for="field-phone">Numer telefonu</label>
                    <input type="tel" id="field-phone" name="contact_phone" class="brief-input" autocomplete="tel" placeholder="+48 600 000 000">
                  </div>
                </div>
              </div>
            </fieldset>

            <!-- Podsumowanie odpowiedzi -->
            <fieldset class="brief-step" data-step="3" aria-hidden="true">
              <legend class="step-legend">Podsumowanie briefu</legend>
              <p class="step-desc">Sprawdź podsumowanie przed wysłaniem. W razie potrzeby kliknij „Edytuj”, aby zmienić odpowiedź.</p>

              <!-- Dynamiczne podsumowanie wstawiane przez JS -->
              <div id="brief-summary-target"></div>

              <p class="form-privacy" style="margin-top:24px;font-size:14px;color:#71717a">
                Wysłanie briefu jest bezpłatne i niezobowiązujące. Twoje dane posłużą wyłącznie do kontaktu i przygotowania wyceny. <a href="/polityka-prywatnosci/" style="color:inherit;text-decoration:underline">Polityka prywatności</a>.
              </p>
            </fieldset>

            <!-- Komunikaty statusu / błędów -->
            <div id="brief-status-box" class="brief-status-box" role="status" aria-live="polite" hidden></div>

            <!-- Dolny pasek nawigacji i przycisków -->
            <div class="brief-actions">
              <button type="button" class="btn-secondary" id="brief-btn-prev" style="display:none;">
                <span aria-hidden="true">&larr;</span>
                <span>Wstecz</span>
              </button>

              <button type="button" class="btn-primary" id="brief-btn-next">
                <span>Dalej</span>
                <span aria-hidden="true">&rarr;</span>
              </button>

              <button type="submit" class="btn-primary" id="brief-btn-submit" style="display:none;">
                <span>Wyślij brief</span>
                <span aria-hidden="true">&rarr;</span>
              </button>
            </div>
          </form>
        </div>

      </div>
    </div>
  </main>
</BaseLayout>
