---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import CtaOrange from '../../../components/CtaOrange.astro';
import imageManifest from '../../../data/image-manifest.json';
import { portfolioEn } from '../../../data/i18n/portfolio-en';

export async function getStaticPaths() {
  const orderedSlugs = [
    'drewmax', 'szkola-best', 'hiker', 'drew-art', 'jd-ubezpieczenia',
    'katalog-drew-art', 'montessori', 'piworob', 'katalog-drewmar', 'ja-i-moj-biznes',
    'gazetka-drewmar', 'self-invest', 'unitrans-katalog', 'mpec-przemysl', 'te-solutions',
    'kancelaria-lampa', 'broszura-pervita24', 'gearexpert', 'katalog-targowy-drewmar', 'pobudka'
  ];

  const projects = await getCollection('portfolio');
  const projectMap = new Map(projects.map((p) => [p.data.slug, p]));

  return orderedSlugs.map((slug, idx) => {
    const project = projectMap.get(slug)!;
    const prevSlug = orderedSlugs[(idx - 1 + orderedSlugs.length) % orderedSlugs.length];
    const nextSlug = orderedSlugs[(idx + 1) % orderedSlugs.length];
    const prevProject = projectMap.get(prevSlug)!;
    const nextProject = projectMap.get(nextSlug)!;

    return {
      params: { slug },
      props: {
        project,
        prevProject: { slug: prevProject.data.slug, title: prevProject.data.title },
        nextProject: { slug: nextProject.data.slug, title: nextProject.data.title },
      },
    };
  });
}

const { project, prevProject, nextProject } = Astro.props;
const p = project.data;
const enData = portfolioEn[p.slug];

const displayTitle = enData?.title || p.title;
const displayDesc = enData?.description || p.description;
const displayCat = enData?.category || p.category;
const displayCoverAlt = enData?.cover_alt || p.cover_alt;
const displayBriefTitle = enData?.brief_title || p.brief_title;
const displayBrief = enData?.brief || p.brief;
const displayDeliverables = enData?.deliverables || p.deliverables;
const displayResultTitle = enData?.result_title || p.result_title;
const displayResult = enData?.result || p.result;
const displayExtLabel = enData?.external_label || p.external_label || 'Open website';

const prevEn = portfolioEn[prevProject.slug];
const nextEn = portfolioEn[nextProject.slug];
const prevDisplayTitle = prevEn?.title || prevProject.title;
const nextDisplayTitle = nextEn?.title || nextProject.title;

const title = `${displayTitle} | Portfolio`;
const description = displayDesc;
const coverSrc = p.cover.startsWith('/') ? p.cover : `/${p.cover}`;
const ogImage = `https://grafmen.com${coverSrc}`;

function getImageInfo(src: string) {
  if (!src) return null;
  const clean = src.startsWith('/') ? src.slice(1) : src;
  const manifest = imageManifest as Record<string, any>;
  return manifest[clean] || null;
}

const coverInfo = getImageInfo(p.cover);
const coverWidth = coverInfo?.width || 1400;
const coverHeight = coverInfo?.height || 920;
const coverSrcset = coverInfo?.srcset || '';
---
<BaseLayout title={title} description={description} currentNav="work" bodyClass="service-page" ogImage={ogImage} lang="en">
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "CreativeWork",
      "name": displayTitle,
      "description": displayDesc,
      "url": `https://grafmen.com/en/portfolio/${p.slug}/`,
      "image": `https://grafmen.com${coverSrc}`,
      "creator": {
        "@type": "Person",
        "name": "Krzysztof Krawczyk"
      }
    })} />
  </Fragment>

  <main id="main-content">
    <article class="project-detail">
      <!-- 1. HEADER & BREADCRUMBS -->
      <section class="project-heading home-inner">
        <nav class="breadcrumbs" aria-label="Breadcrumbs">
          <a href="/en/portfolio/">Portfolio</a> / <span aria-current="page">{displayTitle}</span>
        </nav>
        <p class="home-kicker">{displayCat}{p.year ? ` / ${p.year}` : ''}</p>
        <h1>{displayTitle}</h1>
        <p class="home-lead">{displayDesc}</p>
      </section>

      <!-- 2. GŁÓWNE ZDJĘCIE (COVER) -->
      <figure class="project-cover home-inner">
        <img
          src={coverSrc}
          srcset={coverSrcset || undefined}
          sizes="(max-width: 640px) 100vw, (max-width: 1024px) 92vw, 1400px"
          alt={displayCoverAlt}
          width={coverWidth}
          height={coverHeight}
          fetchpriority="high"
          decoding="async"
        />
      </figure>

      <!-- BANER REKLAMOWY HTML5 (POBUDKA) -->
      {p.slug === 'pobudka' && (
        <section class="project-html5-banner home-inner" id="html5-banner" aria-label="Animated HTML5 display banner">
          <div class="banner-heading">
            <p class="home-kicker"><span class="section-index">DISPLAY PROJECT</span></p>
            <h2>Animated HTML5 display banner</h2>
            <p class="banner-desc">Display format 336&nbsp;×&nbsp;280&nbsp;px · Hover or tap to play animation</p>
          </div>
          <div class="banner-stage-wrapper">
            <div class="banner-stage" id="pobudka-banner-stage" tabindex="0" role="region" aria-label="Interactive preview of Pobudka HTML5 banner">
              <iframe
                id="pobudka-html5-iframe"
                src="/assets/banners/pobudka_HTML5/index.html"
                width="336"
                height="280"
                title="Animated HTML5 banner Pobudka"
                loading="eager"
                scrolling="no"
              ></iframe>
            </div>
            <button type="button" class="banner-replay-btn" id="banner-replay-trigger" aria-label="Replay banner animation">
              <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path d="M1 4v6h6M23 20v-6h-6"></path>
                <path d="M20.49 9A9 9 0 0 0 5.64 5.64L1 10m22 4l-4.64 4.36A9 9 0 0 1 3.51 15"></path>
              </svg>
              <span>Replay animation</span>
            </button>
          </div>
        </section>
      )}

      <!-- 3. POTRZEBA -->
      <section class="home-section">
        <div class="home-inner compact-grid">
          <div>
            <p class="home-kicker">PROJECT NEED</p>
            <h2>{displayBriefTitle}</h2>
          </div>
          <div class="bio-copy">
            {displayBrief.map((paragraph) => (
              <p>{paragraph}</p>
            ))}
          </div>
        </div>
      </section>

      <!-- 4. ZAKRES -->
      <section class="home-section project-scope">
        <div class="home-inner compact-grid">
          <div>
            <p class="home-kicker">SCOPE</p>
            <h2>What I did</h2>
          </div>
          <ul class="scope-list">
            {displayDeliverables.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
        </div>
      </section>

      <!-- 5. PROJEKT W ZASTOSOWANIU (GALERIA) -->
      {p.gallery && p.gallery.length > 0 && (
        <section class="home-section project-gallery-section" id={p.slug === 'hiker' ? 'branding' : undefined}>
          <div class="home-inner">
            <p class="home-kicker">{p.slug === 'hiker' ? 'BRANDING' : 'IMPLEMENTATION'}</p>
            <h2>{p.slug === 'hiker' ? 'Visual identity & motion' : 'Design in application'}</h2>
            <div class="project-gallery">
              {p.gallery.map((item, gIdx) => {
                const itemSrc = item.src.startsWith('/') ? item.src : `/${item.src}`;
                const itemInfo = getImageInfo(item.src);
                const itemWidth = itemInfo?.width || item.width || 1400;
                const itemHeight = itemInfo?.height || item.height || 920;
                const itemSrcset = itemInfo?.srcset || '';
                const isVertical = Boolean(itemInfo?.isVertical ?? (itemHeight && itemWidth && (itemHeight / itemWidth >= 1.25)));

                const enGalleryItem = enData?.gallery?.[gIdx];
                const displayCaption = enGalleryItem?.caption || item.caption;
                const displayItemAlt = enGalleryItem?.alt || item.alt;

                if (item.type === 'video') {
                  const posterSrc = item.poster ? (item.poster.startsWith('/') ? item.poster : `/${item.poster}`) : undefined;
                  return (
                    <figure class={isVertical ? 'gallery-item-vertical' : undefined}>
                      <video
                        class={p.slug === 'hiker' ? 'scroll-autoplay-video' : undefined}
                        src={itemSrc}
                        poster={posterSrc}
                        width={item.width || 1920}
                        height={item.height || 1080}
                        controls
                        playsinline
                        muted
                        preload="metadata"
                        style="width:100%;height:auto;border-radius:16px;display:block;background:#09090b"
                      ></video>
                      {displayCaption && <figcaption>{displayCaption}</figcaption>}
                    </figure>
                  );
                }
                return (
                  <figure class={isVertical ? 'gallery-item-vertical' : undefined}>
                    <img
                      src={itemSrc}
                      srcset={itemSrcset || undefined}
                      sizes={isVertical ? "(max-width: 640px) 100vw, 640px" : "(max-width: 640px) 100vw, (max-width: 1024px) 92vw, 1400px"}
                      alt={displayItemAlt}
                      loading="lazy"
                      decoding="async"
                      width={itemWidth}
                      height={itemHeight}
                    />
                    {displayCaption && <figcaption>{displayCaption}</figcaption>}
                  </figure>
                );
              })}
            </div>
          </div>
        </section>
      )}

      <!-- 6. OPCJONALNY FILM (HIKER) -->
      {p.slug === 'hiker' && (
        <section class="home-section project-film-section" id="film">
          <div class="home-inner compact-grid">
            <div>
              <p class="home-kicker">PROMOTIONAL VIDEO</p>
              <h2>Hiker promotional film</h2>
            </div>
            <div class="bio-copy">
              <p>Promotional film showcasing the Hiker brand amidst mountain terrain and rugged nature. Dynamic outdoor cinematography, interplay of light, and open horizons forge an authentic outdoor atmosphere.</p>
              <p style="margin-top:24px">
                <a class="cta-button" href="https://www.youtube.com/watch?v=WOaOxbPIIhs" target="_blank" rel="noopener noreferrer">
                  Watch film on YouTube <span aria-hidden="true">↗</span>
                </a>
              </p>
            </div>
          </div>
          <div class="home-inner project-film-media" style="margin-top:36px">
            <figure>
              <div
                class="youtube-facade"
                id="hiker-youtube-player"
                data-video-id="WOaOxbPIIhs"
                data-title="Hiker promotional film"
              >
                <button
                  type="button"
                  class="youtube-facade-btn"
                  aria-label="Play Hiker promotional film"
                >
                  <img
                    src="/assets/motion/hiker-film-poster.webp"
                    alt="Hiker promotional film · video thumbnail"
                    width="1920"
                    height="1080"
                    loading="lazy"
                    decoding="async"
                    class="youtube-facade-thumb"
                  />
                  <span class="youtube-facade-play" aria-hidden="true">
                    <svg viewBox="0 0 68 48" width="68" height="48" aria-hidden="true">
                      <path class="yt-play-bg" d="M66.52 7.74c-.78-2.93-2.49-5.41-5.42-6.19C55.79.13 34 0 34 0S12.21.13 6.9 1.55c-2.93.78-4.63 3.26-5.42 6.19C.06 13.05 0 24 0 24s.06 10.95 1.48 16.26c.78 2.93 2.49 5.41 5.42 6.19C12.21 47.87 34 48 34 48s21.79-.13 27.1-1.55c2.93-.78 4.64-3.26 5.42-6.19C67.94 34.95 68 24 68 24s-.06-10.95-1.48-16.26z" fill="#212121" fill-opacity="0.85"></path>
                      <path d="M45 24 27 14v20z" fill="#ffffff"></path>
                    </svg>
                  </span>
                </button>
              </div>
              <figcaption style="margin-top:12px;font-size:14px;color:#62626b">Hiker promotional video · cinematography in mountain scenery.</figcaption>
            </figure>
          </div>
        </section>
      )}

      <!-- 7. REZULTAT -->
      <section class="home-section">
        <div class="home-inner compact-grid">
          <div>
            <p class="home-kicker">RESULT</p>
            <h2>{displayResultTitle}</h2>
          </div>
          <div class="bio-copy">
            {displayResult.map((paragraph) => (
              <p>{paragraph}</p>
            ))}
            {p.testimonial && (
              <article class="testimonial-card" style="margin-top:28px">
                <blockquote>
                  <p>{enData?.testimonial || p.testimonial}</p>
                  <span class="review-trans-note" style="display:block;font-size:12px;color:#71717a;margin-top:12px;font-style:italic">Translated from Polish</span>
                </blockquote>
                {p.testimonial_author && (
                  <footer>
                    <strong>{enData?.testimonial_author || p.testimonial_author}</strong>
                  </footer>
                )}
              </article>
            )}
            {p.external_url && (
              <p style="margin-top:24px">
                <a class="text-link" href={p.external_url} target="_blank" rel="noopener noreferrer">
                  {displayExtLabel} <span aria-hidden="true">&nearr;</span>
                </a>
              </p>
            )}
          </div>
        </div>
      </section>

      <!-- 8. NAWIGACJA MIĘDZY REALIZACJAMI -->
      <section class="project-next home-inner" aria-label="Navigation between case studies">
        <a class="text-link" href={`/en/portfolio/${prevProject.slug}/`} rel="prev">
          <span aria-hidden="true">&larr;</span> Previous: {prevDisplayTitle}
        </a>
        <a class="text-link" href="/en/portfolio/">All projects</a>
        <a class="text-link" href={`/en/portfolio/${nextProject.slug}/`} rel="next">
          Next: {nextDisplayTitle} <span aria-hidden="true">&rarr;</span>
        </a>
      </section>
    </article>

    <!-- 9. CTA -->
    <CtaOrange lang="en" />
  </main>

  <script is:inline>
    document.addEventListener('DOMContentLoaded', function() {
      // YouTube lazy facade
      var ytFacades = document.querySelectorAll('.youtube-facade');
      ytFacades.forEach(function(facade) {
        var btn = facade.querySelector('.youtube-facade-btn');
        if (!btn) return;
        btn.addEventListener('click', function() {
          var videoId = facade.getAttribute('data-video-id');
          var title = facade.getAttribute('data-title') || 'Video';
          if (!videoId) return;

          var iframe = document.createElement('iframe');
          iframe.setAttribute('src', 'https://www.youtube-nocookie.com/embed/' + encodeURIComponent(videoId) + '?autoplay=1&rel=0');
          iframe.setAttribute('title', title);
          iframe.setAttribute('frameborder', '0');
          iframe.setAttribute('allow', 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share');
          iframe.setAttribute('allowfullscreen', 'true');
          iframe.className = 'youtube-facade-iframe';

          facade.innerHTML = '';
          facade.appendChild(iframe);
        });
      });

      // HTML5 Pobudka Banner Replay
      var bannerTrigger = document.getElementById('banner-replay-trigger');
      var bannerIframe = document.getElementById('pobudka-html5-iframe');
      if (bannerTrigger && bannerIframe) {
        bannerTrigger.addEventListener('click', function() {
          var currentSrc = bannerIframe.getAttribute('src');
          bannerIframe.setAttribute('src', '');
          setTimeout(function() {
            bannerIframe.setAttribute('src', currentSrc);
          }, 50);
        });
      }
    });
  </script>
</BaseLayout>
