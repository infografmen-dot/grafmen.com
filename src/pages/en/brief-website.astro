---
import BaseLayout from '../../layouts/BaseLayout.astro';

const title = "Website Project Brief · Pricing & Requirements | Grafmen";
const description = "Fill in a short, 3-step website project brief. Outline your goals, required features, and scope. I will prepare a transparent quote and timeline.";
---
<BaseLayout title={title} description={description} bodyClass="service-page" lang="en" canonicalPath="/en/brief-website/">
  <Fragment slot="head">
    <link rel="stylesheet" href="/brief.css" />
    <script src="/web3forms-client.js" defer></script>
    <script src="/brief-stepper.js" defer></script>
  </Fragment>

  <main id="main-content">
    <div class="home-inner brief-page-wrap">
      <div class="brief-container">
        
        <header class="brief-header">
          <p class="home-kicker">PROJECT BRIEF / WEBSITES</p>
          <h1>Let’s define your new website requirements.</h1>
          <p class="home-lead">A short 3-step form to help clarify your key needs. Your answers will be used to prepare a free, no-obligation proposal and quote.</p>
        </header>

        <!-- Stepper Progress Bar -->
        <div class="brief-stepper" aria-label="Brief progress tracker">
          <div class="stepper-header">
            <span class="stepper-step-indicator" id="stepper-step-indicator">Step 1 of 3</span>
            <span class="stepper-step-title" id="stepper-step-title">Project & Business</span>
          </div>
          <div class="stepper-progress-track" role="progressbar" aria-valuenow="33" aria-valuemin="0" aria-valuemax="100">
            <div class="stepper-progress-bar" id="stepper-progress-bar" style="width: 33%;"></div>
          </div>
        </div>

        <!-- Form Card Box -->
        <div class="brief-card-box">
          <form id="brief-form" data-brief-type="web" novalidate>
            <!-- Anti-spam Honeypot -->
            <input type="checkbox" name="botcheck" class="botcheck-field" tabindex="-1" autocomplete="off" style="display:none !important">

            <!-- STEP 1: Project & Business -->
            <fieldset class="brief-step is-active" data-step="0">
              <legend class="step-legend">Step 1: Project & Business</legend>
              <p class="step-desc">Core context to establish the right structure and tone for your site.</p>

              <div class="brief-group">
                <label class="brief-label">Project type <span class="req" aria-hidden="true">*</span></label>
                <div class="tiles-grid" role="radiogroup" aria-required="true">
                  <label class="tile-choice">
                    <input type="radio" name="project_type" value="New website" class="tile-input" checked>
                    <span class="tile-body">
                      <span class="tile-indicator" aria-hidden="true"></span>
                      <span class="tile-label-wrap">
                        <span class="tile-title">New website</span>
                        <span class="tile-desc">Built from scratch for a new business or brand</span>
                      </span>
                    </span>
                  </label>

                  <label class="tile-choice">
                    <input type="radio" name="project_type" value="Website redesign" class="tile-input">
                    <span class="tile-body">
                      <span class="tile-indicator" aria-hidden="true"></span>
                      <span class="tile-label-wrap">
                        <span class="tile-title">Website redesign</span>
                        <span class="tile-desc">Overhauling design, structure, and technology</span>
                      </span>
                    </span>
                  </label>

                  <label class="tile-choice">
                    <input type="radio" name="project_type" value="Need guidance" class="tile-input">
                    <span class="tile-body">
                      <span class="tile-indicator" aria-hidden="true"></span>
                      <span class="tile-label-wrap">
                        <span class="tile-title">Need guidance</span>
                        <span class="tile-desc">We will decide the best direction together</span>
                      </span>
                    </span>
                  </label>
                </div>
              </div>

              <div class="brief-group">
                <label class="brief-label" for="company-overview">What does your company do, and who is your audience? <span class="req" aria-hidden="true">*</span></label>
                <p class="brief-hint">1–2 sentences about your industry, key services/products, and target customers.</p>
                <textarea id="company-overview" name="company_overview" class="brief-textarea" rows="3" required placeholder="e.g. We design custom furniture for residential clients and modern offices across Europe."></textarea>
              </div>

              <div class="brief-group">
                <label class="brief-label">Primary objective of the website</label>
                <div class="tiles-grid" role="radiogroup">
                  <label class="tile-choice">
                    <input type="radio" name="primary_goal" value="Lead generation & enquiries" class="tile-input" checked>
                    <span class="tile-body">
                      <span class="tile-indicator" aria-hidden="true"></span>
                      <span class="tile-label-wrap">
                        <span class="tile-title">Lead generation</span>
                        <span class="tile-desc">Encouraging enquiries and business contacts</span>
                      </span>
                    </span>
                  </label>

                  <label class="tile-choice">
                    <input type="radio" name="primary_goal" value="Showcase services & brand presence" class="tile-input">
                    <span class="tile-body">
                      <span class="tile-indicator" aria-hidden="true"></span>
                      <span class="tile-label-wrap">
                        <span class="tile-title">Brand showcase</span>
                        <span class="tile-desc">Clear digital presence that builds trust</span>
                      </span>
                    </span>
                  </label>

                  <label class="tile-choice">
                    <input type="radio" name="primary_goal" value="Online sales or bookings" class="tile-input">
                    <span class="tile-body">
                      <span class="tile-indicator" aria-hidden="true"></span>
                      <span class="tile-label-wrap">
                        <span class="tile-title">E-commerce / Sales</span>
                        <span class="tile-desc">Direct online sales or client reservations</span>
                      </span>
                    </span>
                  </label>

                  <label class="tile-choice">
                    <input type="radio" name="primary_goal" value="Other goal" class="tile-input">
                    <span class="tile-body">
                      <span class="tile-indicator" aria-hidden="true"></span>
                      <span class="tile-label-wrap">
                        <span class="tile-title">Other goal</span>
                        <span class="tile-desc">Custom or industry-specific requirements</span>
                      </span>
                    </span>
                  </label>
                </div>
              </div>
            </fieldset>

            <!-- STEP 2: Features & Materials -->
            <fieldset class="brief-step" data-step="1" aria-hidden="true">
              <legend class="step-legend">Step 2: Required Features & Assets</legend>
              <p class="step-desc">Select the elements you expect on the website.</p>

              <div class="brief-group">
                <label class="brief-label">Required features</label>
                <p class="brief-hint">Feature selection helps understand project scope. It does not imply that every feature is included in standard package pricing.</p>
                <div class="tiles-grid">
                  <label class="tile-choice is-checkbox">
                    <input type="checkbox" name="features" value="Service & Offer presentation" class="tile-input" checked>
                    <span class="tile-body">
                      <span class="tile-indicator" aria-hidden="true"><svg class="tile-check-icon" viewBox="0 0 24 24" fill="none"><polyline points="20 6 9 17 4 12"></polyline></svg></span>
                      <span class="tile-title">Service presentation</span>
                    </span>
                  </label>

                  <label class="tile-choice is-checkbox">
                    <input type="checkbox" name="features" value="Portfolio / Case studies" class="tile-input">
                    <span class="tile-body">
                      <span class="tile-indicator" aria-hidden="true"><svg class="tile-check-icon" viewBox="0 0 24 24" fill="none"><polyline points="20 6 9 17 4 12"></polyline></svg></span>
                      <span class="tile-title">Portfolio / Case studies</span>
                    </span>
                  </label>

                  <label class="tile-choice is-checkbox">
                    <input type="checkbox" name="features" value="Blog / News" class="tile-input">
                    <span class="tile-body">
                      <span class="tile-indicator" aria-hidden="true"><svg class="tile-check-icon" viewBox="0 0 24 24" fill="none"><polyline points="20 6 9 17 4 12"></polyline></svg></span>
                      <span class="tile-title">Blog / News</span>
                    </span>
                  </label>

                  <label class="tile-choice is-checkbox">
                    <input type="checkbox" name="features" value="Online shop" class="tile-input">
                    <span class="tile-body">
                      <span class="tile-indicator" aria-hidden="true"><svg class="tile-check-icon" viewBox="0 0 24 24" fill="none"><polyline points="20 6 9 17 4 12"></polyline></svg></span>
                      <span class="tile-title">Online store</span>
                    </span>
                  </label>

                  <label class="tile-choice is-checkbox">
                    <input type="checkbox" name="features" value="Bookings / Calendar" class="tile-input">
                    <span class="tile-body">
                      <span class="tile-indicator" aria-hidden="true"><svg class="tile-check-icon" viewBox="0 0 24 24" fill="none"><polyline points="20 6 9 17 4 12"></polyline></svg></span>
                      <span class="tile-title">Bookings / Calendar</span>
                    </span>
                  </label>

                  <label class="tile-choice is-checkbox">
                    <input type="checkbox" name="features" value="Multilingual support" class="tile-input">
                    <span class="tile-body">
                      <span class="tile-indicator" aria-hidden="true"><svg class="tile-check-icon" viewBox="0 0 24 24" fill="none"><polyline points="20 6 9 17 4 12"></polyline></svg></span>
                      <span class="tile-title">Multilingual versions</span>
                    </span>
                  </label>

                  <label class="tile-choice is-checkbox">
                    <input type="checkbox" name="features" value="Not sure / To discuss" class="tile-input">
                    <span class="tile-body">
                      <span class="tile-indicator" aria-hidden="true"><svg class="tile-check-icon" viewBox="0 0 24 24" fill="none"><polyline points="20 6 9 17 4 12"></polyline></svg></span>
                      <span class="tile-title">Not sure / To discuss</span>
                    </span>
                  </label>
                </div>
              </div>

              <div class="brief-group">
                <label class="brief-label">Available assets</label>
                <div class="tiles-grid">
                  <label class="tile-choice is-checkbox">
                    <input type="checkbox" name="assets" value="Logo / Brand identity" class="tile-input" checked>
                    <span class="tile-body">
                      <span class="tile-indicator" aria-hidden="true"><svg class="tile-check-icon" viewBox="0 0 24 24" fill="none"><polyline points="20 6 9 17 4 12"></polyline></svg></span>
                      <span class="tile-title">Logo / Branding</span>
                    </span>
                  </label>

                  <label class="tile-choice is-checkbox">
                    <input type="checkbox" name="assets" value="Written website copy" class="tile-input">
                    <span class="tile-body">
                      <span class="tile-indicator" aria-hidden="true"><svg class="tile-check-icon" viewBox="0 0 24 24" fill="none"><polyline points="20 6 9 17 4 12"></polyline></svg></span>
                      <span class="tile-title">Ready copy / texts</span>
                    </span>
                  </label>

                  <label class="tile-choice is-checkbox">
                    <input type="checkbox" name="assets" value="High quality photos & imagery" class="tile-input">
                    <span class="tile-body">
                      <span class="tile-indicator" aria-hidden="true"><svg class="tile-check-icon" viewBox="0 0 24 24" fill="none"><polyline points="20 6 9 17 4 12"></polyline></svg></span>
                      <span class="tile-title">Photos & imagery</span>
                    </span>
                  </label>

                  <label class="tile-choice is-checkbox">
                    <input type="checkbox" name="assets" value="Need help preparing assets" class="tile-input">
                    <span class="tile-body">
                      <span class="tile-indicator" aria-hidden="true"><svg class="tile-check-icon" viewBox="0 0 24 24" fill="none"><polyline points="20 6 9 17 4 12"></polyline></svg></span>
                      <span class="tile-title">Need help with assets</span>
                    </span>
                  </label>
                </div>
              </div>

              <div class="brief-group">
                <label class="brief-label" for="web-references">Current website URL or reference links (optional)</label>
                <p class="brief-hint">If you have an existing site or websites you admire, paste the links here.</p>
                <input type="text" id="web-references" name="references" class="brief-input" placeholder="e.g. https://currentsite.com, https://inspiration.com">
              </div>
            </fieldset>

            <!-- STEP 3: Timeline, Budget & Contact -->
            <fieldset class="brief-step" data-step="2" aria-hidden="true">
              <legend class="step-legend">Step 3: Timeline, Budget & Contact</legend>
              <p class="step-desc">Final step: provide your timeline expectations and contact details for the proposal.</p>

              <div class="brief-group">
                <label class="brief-label">Estimated timeline</label>
                <div class="tiles-grid" role="radiogroup">
                  <label class="tile-choice">
                    <input type="radio" name="timeline" value="Within 1–2 months" class="tile-input" checked>
                    <span class="tile-body">
                      <span class="tile-indicator" aria-hidden="true"></span>
                      <span class="tile-title">Within 1–2 months</span>
                    </span>
                  </label>

                  <label class="tile-choice">
                    <input type="radio" name="timeline" value="Within 3–6 months" class="tile-input">
                    <span class="tile-body">
                      <span class="tile-indicator" aria-hidden="true"></span>
                      <span class="tile-title">Within 3–6 months</span>
                    </span>
                  </label>

                  <label class="tile-choice">
                    <input type="radio" name="timeline" value="As soon as possible" class="tile-input">
                    <span class="tile-body">
                      <span class="tile-indicator" aria-hidden="true"></span>
                      <span class="tile-title">As soon as possible</span>
                    </span>
                  </label>

                  <label class="tile-choice">
                    <input type="radio" name="timeline" value="To be discussed" class="tile-input">
                    <span class="tile-body">
                      <span class="tile-indicator" aria-hidden="true"></span>
                      <span class="tile-title">To be discussed</span>
                    </span>
                  </label>
                </div>
              </div>

              <div class="brief-group">
                <label class="brief-label">Estimated budget</label>
                <div class="tiles-grid" role="radiogroup">
                  <label class="tile-choice">
                    <input type="radio" name="budget" value="€500 – €1,000" class="tile-input">
                    <span class="tile-body">
                      <span class="tile-indicator" aria-hidden="true"></span>
                      <span class="tile-title">€500 – €1,000</span>
                    </span>
                  </label>

                  <label class="tile-choice">
                    <input type="radio" name="budget" value="€1,000 – €2,000" class="tile-input" checked>
                    <span class="tile-body">
                      <span class="tile-indicator" aria-hidden="true"></span>
                      <span class="tile-title">€1,000 – €2,000</span>
                    </span>
                  </label>

                  <label class="tile-choice">
                    <input type="radio" name="budget" value="€2,000+" class="tile-input">
                    <span class="tile-body">
                      <span class="tile-indicator" aria-hidden="true"></span>
                      <span class="tile-title">€2,000+</span>
                    </span>
                  </label>

                  <label class="tile-choice">
                    <input type="radio" name="budget" value="Need a quote" class="tile-input">
                    <span class="tile-body">
                      <span class="tile-indicator" aria-hidden="true"></span>
                      <span class="tile-title">Need a quote</span>
                    </span>
                  </label>
                </div>
              </div>

              <div class="brief-group">
                <label class="brief-label" for="contact-name">Name or contact person <span class="req" aria-hidden="true">*</span></label>
                <input type="text" id="contact-name" name="contact_name" class="brief-input" required autocomplete="name" placeholder="Alex Morgan">
              </div>

              <div class="brief-group">
                <label class="brief-label" for="contact-email">Email address for the reply <span class="req" aria-hidden="true">*</span></label>
                <input type="email" id="contact-email" name="contact_email" class="brief-input" required autocomplete="email" placeholder="alex@company.com">
                
                <div class="phone-toggle-wrap">
                  <button type="button" class="phone-toggle-btn" id="toggle-phone-btn" aria-expanded="false">
                    <span>+ Add phone number (optional)</span>
                  </button>
                  <div class="phone-field-box" id="phone-field-box" hidden>
                    <label class="brief-label" for="field-phone">Phone number</label>
                    <input type="tel" id="field-phone" name="contact_phone" class="brief-input" autocomplete="tel" placeholder="+44 7000 000000">
                  </div>
                </div>
              </div>
            </fieldset>

            <!-- STEP 4: Review & Submit -->
            <fieldset class="brief-step" data-step="3" aria-hidden="true">
              <legend class="step-legend">Step 4: Review Your Brief</legend>
              <p class="step-desc">Please review your answers before submitting. Click “Edit” on any section to make adjustments.</p>

              <!-- Dynamic summary injected by JS -->
              <div id="brief-summary-target"></div>

              <p class="form-privacy" style="margin-top:24px;font-size:14px;color:#71717a">
                Submitting this brief is completely non-binding. Your details are used strictly to reply and prepare your quote. <a href="/en/privacy-policy/" style="color:inherit">Privacy policy</a>.
              </p>
            </fieldset>

            <!-- Status & Error Notices -->
            <div id="brief-status-box" class="brief-status-box" role="status" aria-live="polite" hidden></div>

            <!-- Actions Bar -->
            <div class="brief-actions">
              <button type="button" class="btn-secondary" id="brief-btn-prev" style="display:none;">
                <span aria-hidden="true">&larr;</span>
                <span>Back</span>
              </button>

              <button type="button" class="btn-primary" id="brief-btn-next">
                <span>Continue</span>
                <span aria-hidden="true">&rarr;</span>
              </button>

              <button type="submit" class="btn-primary" id="brief-btn-submit" style="display:none;">
                <span>Send brief</span>
                <span aria-hidden="true">&rarr;</span>
              </button>
            </div>
          </form>
        </div>

      </div>
    </div>
  </main>
</BaseLayout>
