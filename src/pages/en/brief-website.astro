---
import BaseLayout from '../../layouts/BaseLayout.astro';

const title = "Website Project Brief · Pricing & Requirements | Grafmen";
const description = "Fill in a short, 3-step website project brief. Outline your goals, required features, and scope. I will prepare a transparent quote and timeline.";
---
<BaseLayout title={title} description={description} bodyClass="service-page" lang="en" canonicalPath="/en/brief-website/">
  <Fragment slot="head">
    <link rel="stylesheet" href="/brief.css" />
    <script src="/web3forms-client.js" defer></script>
    <script src="/brief-stepper.js" defer></script>
  </Fragment>

  <main id="main-content">
    <div class="home-inner brief-page-wrap">
      <div class="brief-container">
        
        <!-- Intro: vertical, left-aligned, isolated from global header -->
        <div class="brief-intro-block">
          <p class="brief-intro-kicker">BRIEF / WEBSITES</p>
          <h1 class="brief-intro-title">Tell me about your website.</h1>
          <p class="brief-intro-lead">Answer a few questions. They will help me prepare the scope of work and an estimate.</p>
        </div>

        <!-- Stepper progress tracker -->
        <div class="brief-stepper" aria-label="Brief progress tracker">
          <div class="stepper-header">
            <span class="stepper-step-indicator" id="stepper-step-indicator">Step 1 of 3</span>
            <span class="stepper-step-title" id="stepper-step-title">Project & Business</span>
          </div>
          <div class="stepper-progress-track" role="progressbar" aria-valuenow="33" aria-valuemin="0" aria-valuemax="100">
            <div class="stepper-progress-bar" id="stepper-progress-bar" style="width: 33%;"></div>
          </div>
        </div>

        <!-- Form card (white background, single subtle border, semantic fieldsets) -->
        <div class="brief-card-box">
          <form id="brief-form" data-brief-type="web" novalidate>
            <!-- Anti-spam Honeypot -->
            <input type="checkbox" name="botcheck" class="botcheck-field" tabindex="-1" autocomplete="off" style="display:none !important">

            <!-- STEP 1: Project & Business -->
            <fieldset class="brief-step is-active" data-step="0">
              <legend class="step-legend">Step 1: Project & Business</legend>
              <p class="step-desc">Core context to establish the right structure and tone for your site.</p>

              <div class="brief-group">
                <label class="brief-label">Project type <span class="req" aria-hidden="true">*</span></label>
                <div class="tiles-grid is-3" role="radiogroup" aria-required="true">
                  <label class="tile-choice">
                    <input type="radio" name="project_type" value="New website" class="tile-input">
                    <span class="tile-body">
                      <span class="tile-indicator" aria-hidden="true"></span>
                      <span class="tile-label-wrap">
                        <span class="tile-title">New website</span>
                        <span class="tile-desc">Built from scratch for a new business</span>
                      </span>
                    </span>
                  </label>

                  <label class="tile-choice">
                    <input type="radio" name="project_type" value="Website redesign" class="tile-input">
                    <span class="tile-body">
                      <span class="tile-indicator" aria-hidden="true"></span>
                      <span class="tile-label-wrap">
                        <span class="tile-title">Website redesign</span>
                        <span class="tile-desc">Overhauling design and technology</span>
                      </span>
                    </span>
                  </label>

                  <label class="tile-choice">
                    <input type="radio" name="project_type" value="Need guidance" class="tile-input">
                    <span class="tile-body">
                      <span class="tile-indicator" aria-hidden="true"></span>
                      <span class="tile-label-wrap">
                        <span class="tile-title">Need guidance</span>
                        <span class="tile-desc">We will determine the direction together</span>
                      </span>
                    </span>
                  </label>
                </div>
              </div>

              <div class="brief-group">
                <label class="brief-label" for="company-overview">What does your company do, and who is your audience? <span class="req" aria-hidden="true">*</span></label>
                <textarea id="company-overview" name="company_overview" class="brief-textarea" rows="3" required placeholder="e.g. We craft custom furniture for residential clients and modern offices across Europe."></textarea>
              </div>

              <div class="brief-group">
                <label class="brief-label">Primary objective of the website</label>
                <div class="tiles-grid" role="radiogroup">
                  <label class="tile-choice">
                    <input type="radio" name="primary_goal" value="Lead generation & enquiries" class="tile-input">
                    <span class="tile-body">
                      <span class="tile-indicator" aria-hidden="true"></span>
                      <span class="tile-label-wrap">
                        <span class="tile-title">Lead generation</span>
                        <span class="tile-desc">Encouraging inquiries and quotes</span>
                      </span>
                    </span>
                  </label>

                  <label class="tile-choice">
                    <input type="radio" name="primary_goal" value="Brand image & showcase" class="tile-input">
                    <span class="tile-body">
                      <span class="tile-indicator" aria-hidden="true"></span>
                      <span class="tile-label-wrap">
                        <span class="tile-title">Brand image</span>
                        <span class="tile-desc">Professional showcase building trust</span>
                      </span>
                    </span>
                  </label>

                  <label class="tile-choice">
                    <input type="radio" name="primary_goal" value="Online sales & ecommerce" class="tile-input">
                    <span class="tile-body">
                      <span class="tile-indicator" aria-hidden="true"></span>
                      <span class="tile-label-wrap">
                        <span class="tile-title">Online sales</span>
                        <span class="tile-desc">Product catalog or online ordering</span>
                      </span>
                    </span>
                  </label>

                  <label class="tile-choice">
                    <input type="radio" name="primary_goal" value="Other goal" class="tile-input">
                    <span class="tile-body">
                      <span class="tile-indicator" aria-hidden="true"></span>
                      <span class="tile-label-wrap">
                        <span class="tile-title">Other goal</span>
                        <span class="tile-desc">Custom or industry-specific scope</span>
                      </span>
                    </span>
                  </label>
                </div>
              </div>
            </fieldset>

            <!-- STEP 2: Features & Materials -->
            <fieldset class="brief-step" data-step="1" aria-hidden="true">
              <legend class="step-legend">Step 2: Features & Materials</legend>
              <p class="step-desc">Select elements that should be included in your project.</p>

              <div class="brief-group">
                <label class="brief-label">Required website features</label>
                <p class="brief-hint">Helps identify needs – exact features are confirmed in the final quote.</p>
                <div class="tiles-grid">
                  <label class="tile-choice is-checkbox">
                    <input type="checkbox" name="features" value="Service & offer presentation" class="tile-input">
                    <span class="tile-body">
                      <span class="tile-indicator" aria-hidden="true"><svg class="tile-check-icon" viewBox="0 0 24 24" fill="none"><polyline points="20 6 9 17 4 12"></polyline></svg></span>
                      <span class="tile-title">Services & offer</span>
                    </span>
                  </label>

                  <label class="tile-choice is-checkbox">
                    <input type="checkbox" name="features" value="Portfolio & case studies" class="tile-input">
                    <span class="tile-body">
                      <span class="tile-indicator" aria-hidden="true"><svg class="tile-check-icon" viewBox="0 0 24 24" fill="none"><polyline points="20 6 9 17 4 12"></polyline></svg></span>
                      <span class="tile-title">Portfolio & cases</span>
                    </span>
                  </label>

                  <label class="tile-choice is-checkbox">
                    <input type="checkbox" name="features" value="Blog & articles" class="tile-input">
                    <span class="tile-body">
                      <span class="tile-indicator" aria-hidden="true"><svg class="tile-check-icon" viewBox="0 0 24 24" fill="none"><polyline points="20 6 9 17 4 12"></polyline></svg></span>
                      <span class="tile-title">Blog & news</span>
                    </span>
                  </label>

                  <label class="tile-choice is-checkbox">
                    <input type="checkbox" name="features" value="E-commerce store" class="tile-input">
                    <span class="tile-body">
                      <span class="tile-indicator" aria-hidden="true"><svg class="tile-check-icon" viewBox="0 0 24 24" fill="none"><polyline points="20 6 9 17 4 12"></polyline></svg></span>
                      <span class="tile-title">E-commerce store</span>
                    </span>
                  </label>

                  <label class="tile-choice is-checkbox">
                    <input type="checkbox" name="features" value="Booking & calendar" class="tile-input">
                    <span class="tile-body">
                      <span class="tile-indicator" aria-hidden="true"><svg class="tile-check-icon" viewBox="0 0 24 24" fill="none"><polyline points="20 6 9 17 4 12"></polyline></svg></span>
                      <span class="tile-title">Booking / calendar</span>
                    </span>
                  </label>

                  <label class="tile-choice is-checkbox">
                    <input type="checkbox" name="features" value="Multilingual support" class="tile-input">
                    <span class="tile-body">
                      <span class="tile-indicator" aria-hidden="true"><svg class="tile-check-icon" viewBox="0 0 24 24" fill="none"><polyline points="20 6 9 17 4 12"></polyline></svg></span>
                      <span class="tile-title">Multilingual (e.g. EN/PL)</span>
                    </span>
                  </label>
                </div>
              </div>

              <div class="brief-group">
                <label class="brief-label">Available project assets</label>
                <div class="tiles-grid">
                  <label class="tile-choice is-checkbox">
                    <input type="checkbox" name="assets" value="Logo & visual identity" class="tile-input">
                    <span class="tile-body">
                      <span class="tile-indicator" aria-hidden="true"><svg class="tile-check-icon" viewBox="0 0 24 24" fill="none"><polyline points="20 6 9 17 4 12"></polyline></svg></span>
                      <span class="tile-title">Logo & branding</span>
                    </span>
                  </label>

                  <label class="tile-choice is-checkbox">
                    <input type="checkbox" name="assets" value="Ready website copy" class="tile-input">
                    <span class="tile-body">
                      <span class="tile-indicator" aria-hidden="true"><svg class="tile-check-icon" viewBox="0 0 24 24" fill="none"><polyline points="20 6 9 17 4 12"></polyline></svg></span>
                      <span class="tile-title">Website copy</span>
                    </span>
                  </label>

                  <label class="tile-choice is-checkbox">
                    <input type="checkbox" name="assets" value="High quality photos & graphics" class="tile-input">
                    <span class="tile-body">
                      <span class="tile-indicator" aria-hidden="true"><svg class="tile-check-icon" viewBox="0 0 24 24" fill="none"><polyline points="20 6 9 17 4 12"></polyline></svg></span>
                      <span class="tile-title">Photos & imagery</span>
                    </span>
                  </label>

                  <label class="tile-choice is-checkbox">
                    <input type="checkbox" name="assets" value="Need help with materials" class="tile-input">
                    <span class="tile-body">
                      <span class="tile-indicator" aria-hidden="true"><svg class="tile-check-icon" viewBox="0 0 24 24" fill="none"><polyline points="20 6 9 17 4 12"></polyline></svg></span>
                      <span class="tile-title">Need help with assets</span>
                    </span>
                  </label>
                </div>
              </div>

              <div class="brief-group">
                <label class="brief-label" for="web-references">Current website or design inspiration (optional)</label>
                <input type="text" id="web-references" name="references" class="brief-input" placeholder="e.g. https://currentsite.com or links to websites you like">
              </div>
            </fieldset>

            <!-- STEP 3: Timeline, Budget & Contact -->
            <fieldset class="brief-step" data-step="2" aria-hidden="true">
              <legend class="step-legend">Step 3: Timeline, Budget & Contact</legend>
              <p class="step-desc">Final step: specify timeline and contact details for the proposal.</p>

              <div class="brief-group">
                <label class="brief-label">Estimated timeline</label>
                <div class="tiles-grid" role="radiogroup">
                  <label class="tile-choice">
                    <input type="radio" name="timeline" value="As soon as possible (1-2 weeks)" class="tile-input">
                    <span class="tile-body">
                      <span class="tile-indicator" aria-hidden="true"></span>
                      <span class="tile-title">ASAP (1–2 weeks)</span>
                    </span>
                  </label>

                  <label class="tile-choice">
                    <input type="radio" name="timeline" value="Within 1 month" class="tile-input">
                    <span class="tile-body">
                      <span class="tile-indicator" aria-hidden="true"></span>
                      <span class="tile-title">Within 1 month</span>
                    </span>
                  </label>

                  <label class="tile-choice">
                    <input type="radio" name="timeline" value="Within 2-3 months" class="tile-input">
                    <span class="tile-body">
                      <span class="tile-indicator" aria-hidden="true"></span>
                      <span class="tile-title">Within 2–3 months</span>
                    </span>
                  </label>

                  <label class="tile-choice">
                    <input type="radio" name="timeline" value="Flexible" class="tile-input">
                    <span class="tile-body">
                      <span class="tile-indicator" aria-hidden="true"></span>
                      <span class="tile-title">Flexible timeline</span>
                    </span>
                  </label>
                </div>
              </div>

              <div class="brief-group">
                <label class="brief-label">Estimated budget</label>
                <div class="tiles-grid" role="radiogroup">
                  <label class="tile-choice">
                    <input type="radio" name="budget" value="€500 – €1,000" class="tile-input">
                    <span class="tile-body">
                      <span class="tile-indicator" aria-hidden="true"></span>
                      <span class="tile-title">€500 – €1,000</span>
                    </span>
                  </label>

                  <label class="tile-choice">
                    <input type="radio" name="budget" value="€1,000 – €2,000" class="tile-input">
                    <span class="tile-body">
                      <span class="tile-indicator" aria-hidden="true"></span>
                      <span class="tile-title">€1,000 – €2,000</span>
                    </span>
                  </label>

                  <label class="tile-choice">
                    <input type="radio" name="budget" value="Above €2,000" class="tile-input">
                    <span class="tile-body">
                      <span class="tile-indicator" aria-hidden="true"></span>
                      <span class="tile-title">Above €2,000</span>
                    </span>
                  </label>

                  <label class="tile-choice">
                    <input type="radio" name="budget" value="To be discussed" class="tile-input">
                    <span class="tile-body">
                      <span class="tile-indicator" aria-hidden="true"></span>
                      <span class="tile-title">To be discussed</span>
                    </span>
                  </label>
                </div>
              </div>

              <div class="brief-group">
                <label class="brief-label" for="contact-name">Name or contact person <span class="req" aria-hidden="true">*</span></label>
                <input type="text" id="contact-name" name="contact_name" class="brief-input" required autocomplete="name" placeholder="e.g. John Doe">
              </div>

              <div class="brief-group">
                <label class="brief-label" for="contact-email">Email address for response <span class="req" aria-hidden="true">*</span></label>
                <input type="email" id="contact-email" name="contact_email" class="brief-input" required autocomplete="email" placeholder="e.g. john@yourcompany.com">
                
                <div class="phone-toggle-wrap">
                  <button type="button" class="phone-toggle-btn" id="toggle-phone-btn" aria-expanded="false">
                    <span>+ Add phone number (optional)</span>
                  </button>
                  <div class="phone-field-box" id="phone-field-box" hidden>
                    <label class="brief-label" for="field-phone">Phone number</label>
                    <input type="tel" id="field-phone" name="contact_phone" class="brief-input" autocomplete="tel" placeholder="+44 7000 000000">
                  </div>
                </div>
              </div>
            </fieldset>

            <!-- STEP 4: Review & Submit -->
            <fieldset class="brief-step" data-step="3" aria-hidden="true">
              <legend class="step-legend">Step 4: Review & Submit</legend>
              <p class="step-desc">Review your answers before sending. Click "Edit" on any section if needed.</p>

              <!-- Dynamic summary injected by JS -->
              <div id="brief-summary-target"></div>

              <p class="form-privacy" style="margin-top:24px;font-size:14px;color:#71717a">
                Submitting this brief is free and comes with no obligations. Your data will only be used to contact you and prepare an estimate. <a href="/en/privacy-policy/" style="color:inherit;text-decoration:underline">Privacy policy</a>.
              </p>
            </fieldset>

            <!-- Status and feedback notices -->
            <div id="brief-status-box" class="brief-status-box" role="status" aria-live="polite" hidden></div>

            <!-- Action buttons -->
            <div class="brief-actions">
              <button type="button" class="btn-secondary" id="brief-btn-prev" style="display:none;">
                <span aria-hidden="true">&larr;</span>
                <span>Back</span>
              </button>

              <button type="button" class="btn-primary" id="brief-btn-next">
                <span>Continue</span>
                <span aria-hidden="true">&rarr;</span>
              </button>

              <button type="submit" class="btn-primary" id="brief-btn-submit" style="display:none;">
                <span>Send brief</span>
                <span aria-hidden="true">&rarr;</span>
              </button>
            </div>
          </form>
        </div>

      </div>
    </div>
  </main>
</BaseLayout>
