---
import { ui } from '../data/i18n/ui';

interface Props {
  lang?: 'pl' | 'en';
  altLangUrl?: string;
}

const { lang = 'pl', altLangUrl } = Astro.props;
const isEn = lang === 'en';
const t = ui[lang].footer;

const workHref = isEn ? '/en/portfolio/' : '/portfolio/';
const howIWorkHref = isEn ? '/en/about/#how-i-work' : '/o-mnie/#jak-pracuje';
const webPricingHref = isEn ? '/en/websites/#packages' : '/strony-www/#pakiety';
const brandPricingHref = isEn ? '/en/branding/#packages' : '/branding/#pakiety';
const faqHref = isEn ? '/en/#faq' : '/#faq';
const blogHref = isEn ? '/en/blog/' : '/blog/';
const webServicesHref = isEn ? '/en/websites/' : '/strony-www/';
const redesignHref = isEn ? '/en/redesign/' : '/modernizacja/';
const brandingHref = isEn ? '/en/branding/' : '/branding/';
const contactHref = isEn ? '/en/contact/' : '/kontakt/';
const privacyHref = isEn ? '/en/privacy-policy/' : '/polityka-prywatnosci/';
const homeAnchor = '#top';
---
<footer class="site-footer" lang={isEn ? 'en-GB' : 'pl'}>
  <div class="home-inner footer-main">
    <div class="footer-brand">
      <a class="footer-home" href={homeAnchor} aria-label={isEn ? "Grafmen: back to top" : "Grafmen: strona główna"}>
        <img src="/assets/logo-grafmen-light.svg" alt="Grafmen" width="142" height="47" loading="lazy">
      </a>
      <p set:html={t.tagline}></p>
    </div>
    <div class="footer-nav">
      <p class="footer-label">{t.navLabel}</p>
      <a href={workHref}>{ui[lang].nav.work}</a>
      <a href={howIWorkHref}>{t.howIWork}</a>
      <a href={webPricingHref}>{t.webPricing}</a>
      <a href={brandPricingHref}>{t.brandPricing}</a>
      <a href={faqHref}>{t.faq}</a>
      <a href={blogHref}>{t.blog}</a>
    </div>
    <div class="footer-nav">
      <p class="footer-label">{t.servicesLabel}</p>
      <a href={webServicesHref}>{t.webServices}</a>
      <a href={redesignHref}>{t.redesign}</a>
      <a href={brandingHref}>{t.branding}</a>
      <a href={contactHref}>{t.contact}</a>
    </div>
    <div class="footer-contact">
      <p class="footer-label">{t.remoteLabel}</p>
      <p set:html={t.remoteSub}></p>
      <div class="social-links">
        <a href="https://www.facebook.com/grafmen" target="_blank" rel="noopener noreferrer">Facebook</a>
        <a href="https://www.instagram.com/grafmen" target="_blank" rel="noopener noreferrer">Instagram</a>
        <a href="https://www.linkedin.com/in/krzysztof-krawczyk-grafmen" target="_blank" rel="noopener noreferrer">LinkedIn</a>
      </div>
    </div>
  </div>
  <div class="home-inner footer-bottom">
    <span>© Grafmen · Krzysztof Krawczyk</span>
    <a href={privacyHref}>{t.privacy}</a>
    <button
      class="footer-cookies-btn"
      type="button"
      onclick="window.gmCookies && window.gmCookies.reset()"
    >{t.cookiesBtn}</button>
    <span class="footer-lang-switch">
      {isEn ? (
        <>
          <a href={altLangUrl || '/'} aria-label="Wersja polska">PL</a> / <strong>EN</strong>
        </>
      ) : (
        <>
          <strong>PL</strong> / <a href={altLangUrl || '/en/'} aria-label="English version">EN</a>
        </>
      )}
    </span>
  </div>
</footer>
<button class="back-to-top" type="button" aria-label={t.backToTop} hidden>
  <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
    <path d="m6 14 6-6 6 6"/>
  </svg>
</button>
