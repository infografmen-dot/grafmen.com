---
interface Props {
  lang?: 'pl' | 'en';
}

const { lang = 'pl' } = Astro.props;
const isEn = lang === 'en';
---
<section class="home-section audience-section" id="pakiety" lang={isEn ? 'en-GB' : 'pl'}>
  <span id={isEn ? "who-its-for" : "dla-kogo"} class="scroll-target" aria-hidden="true"></span>
  <div class="home-inner">
    <div class="compact-grid">
      <div>
        <p class="home-kicker">{isEn ? "COLLABORATION" : "WSPÓŁPRACA"}</p>
        <h2 data-motion="heading-reveal">
          {isEn ? <>A&nbsp;single project<br>or&nbsp;ongoing&nbsp;partnership.</> : <>Jednorazowy projekt<br>lub&nbsp;stała&nbsp;współpraca.</>}
        </h2>
      </div>
      <div>
        <p class="home-lead">
          {isEn ? (
            "I design websites, visual identities, or marketing materials for your business, from social media graphics and online campaigns to HTML5 banners, print, animation, and video."
          ) : (
            "Przygotuję stronę internetową, identyfikację wizualną lub materiały reklamowe dla\u00A0Twojej firmy, od\u00A0grafik do\u00A0social media i\u00A0kampanii online po\u00A0banery HTML5, druk, animacje i\u00A0wideo."
          )}
        </p>
        <div class="collab-meta-link">
          <a href={isEn ? "/en/about/#how-i-work" : "/o-mnie/#jak-pracuje"}>
            {isEn ? "Explore my workflow" : "Poznaj mój sposób pracy"} <span aria-hidden="true">&rarr;</span>
          </a>
        </div>
      </div>
    </div>

    <div class="collab-cards-wrap">
      <div class="collab-cards">
        <a class="collab-card" href={isEn ? "/en/websites/#packages" : "/strony-www/#pakiety"}>
          <div class="collab-card-media">
            <img src="/assets/portfolio/montessori/screenshot-montessori.webp" alt={isEn ? "Montessori Nursery School Website" : "Strona internetowa Prywatne Przedszkole Montessori"} width="600" height="375" loading="lazy" decoding="async">
          </div>
          <div class="collab-card-body">
            <span class="collab-card-tag">{isEn ? "Websites" : "Strony internetowe"}</span>
            <h3 class="collab-card-title">{isEn ? "Websites" : "Strony WWW"}</h3>
            <p class="collab-card-desc">{isEn ? "A website design that clarifies your offer and makes contacting your business effortless." : "Projekt strony, który porządkuje ofertę i\u00A0ułatwia kontakt z\u00A0Twoją firmą."}</p>
            <span class="collab-card-action">{isEn ? "View website packages and prices" : "Zobacz pakiety i\u00A0ceny stron WWW"} <span aria-hidden="true">&rarr;</span></span>
          </div>
        </a>

        <a class="collab-card" href={isEn ? "/en/branding/#packages" : "/branding/#pakiety"}>
          <div class="collab-card-media">
            <img src="/assets/portfolio/gearexpert/gearExpert_4-www.jpg" alt={isEn ? "GearExpert visual identity · folder, stationery, and business cards" : "Identyfikacja wizualna GearExpert · teczka, papier firmowy i\u00A0wizytówki"} width="600" height="375" loading="lazy" decoding="async">
          </div>
          <div class="collab-card-body">
            <span class="collab-card-tag">{isEn ? "Logo & branding" : "Logo i\u00A0branding"}</span>
            <h3 class="collab-card-title">{isEn ? "Visual identity" : "Identyfikacja wizualna"}</h3>
            <p class="collab-card-desc">{isEn ? "Logo, colours, and assets that create a coherent identity for your business." : "Logo, kolory i\u00A0materiały, które tworzą spójny wizerunek Twojej firmy."}</p>
            <span class="collab-card-action">{isEn ? "View branding packages and prices" : "Zobacz pakiety i\u00A0ceny brandingu"} <span aria-hidden="true">&rarr;</span></span>
          </div>
        </a>
      </div>
    </div>
  </div>
</section>
