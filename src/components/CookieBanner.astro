<!--
  CookieBanner — informacyjny pasek prywatności (pill style)
  Wzorowany na Studio Ahremark: matowe szkło, kapsułka w lewym dolnym rogu.
  Dwa przyciski: [Prywatność] [Zamknij].
  Domyślnie hidden; cookie-banner.js ujawnia gdy potrzeba.
-->
<div
  id="cookie-banner"
  role="region"
  aria-label="Informacja o prywatności"
  aria-hidden="true"
  hidden
>
  <!-- Panel szczegółowy (pojawia się nad kapsułką po kliknięciu "Prywatność") -->
  <div
    class="cb-info-panel"
    id="cb-info-panel"
    role="dialog"
    aria-modal="false"
    aria-labelledby="cb-info-title"
    hidden
  >
    <div class="cb-info-header">
      <span class="cb-info-title" id="cb-info-title">Prywatność na&nbsp;stronie</span>
      <button
        class="cb-info-close"
        id="cb-info-close"
        type="button"
        aria-label="Zamknij panel informacji"
      >×</button>
    </div>
    <p class="cb-info-text">
      W&nbsp;przeglądarce zapamiętujemy zamknięcie tego&nbsp;komunikatu, aby nie wyświetlać go ponownie. Informacje o&nbsp;przetwarzaniu danych znajdziesz w&nbsp;polityce prywatności.
    </p>
    <a class="cb-info-link" href="/polityka-prywatnosci/">Polityka prywatności <span aria-hidden="true">&rarr;</span></a>
  </div>

  <!-- Kapsułka: [Prywatność] [Zamknij] -->
  <div class="cb-pill">
    <button
      id="cookie-banner-privacy"
      type="button"
      class="cb-btn-privacy"
      aria-expanded="false"
      aria-controls="cb-info-panel"
    >Prywatność</button>
    <button
      id="cookie-banner-close"
      type="button"
      class="cb-btn-close"
    >Zamknij</button>
  </div>
</div>
