---
import { ui } from '../data/i18n/ui';

interface Props {
  lang?: 'pl' | 'en';
}

const { lang = 'pl' } = Astro.props;
const isEn = lang === 'en';
const t = ui[lang].cookieBanner;
const privacyHref = isEn ? '/en/privacy-policy/' : '/polityka-prywatnosci/';
---
<!--
  CookieBanner — informacyjny pasek prywatności (pill style)
  Wzorowany na Studio Ahremark: matowe szkło, kapsułka w lewym dolnym rogu.
  Dwa przyciski: [Prywatność / Privacy] [Zamknij / Close].
  Domyślnie hidden; cookie-banner.js ujawnia gdy potrzeba.
-->
<div
  id="cookie-banner"
  role="region"
  aria-label={t.regionAria}
  aria-hidden="true"
  hidden
  lang={isEn ? 'en-GB' : 'pl'}
>
  <!-- Panel szczegółowy (pojawia się nad kapsułką po kliknięciu "Prywatność") -->
  <div
    class="cb-info-panel"
    id="cb-info-panel"
    role="dialog"
    aria-modal="false"
    aria-labelledby="cb-info-title"
    hidden
  >
    <div class="cb-info-header">
      <span class="cb-info-title" id="cb-info-title">{t.panelTitle}</span>
      <button
        class="cb-info-close"
        id="cb-info-close"
        type="button"
        aria-label={t.panelCloseAria}
      >×</button>
    </div>
    <p class="cb-info-text">
      {t.panelText}
    </p>
    <a class="cb-info-link" href={privacyHref}>{t.privacyLinkText} <span aria-hidden="true">&rarr;</span></a>
  </div>

  <!-- Kapsułka: [Prywatność] [Zamknij] -->
  <div class="cb-pill">
    <button
      id="cookie-banner-privacy"
      type="button"
      class="cb-btn-privacy"
      aria-expanded="false"
      aria-controls="cb-info-panel"
    >{t.btnPrivacy}</button>
    <button
      id="cookie-banner-close"
      type="button"
      class="cb-btn-close"
    >{t.btnClose}</button>
  </div>
</div>
