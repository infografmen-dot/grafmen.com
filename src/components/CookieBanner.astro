<!--
  CookieBanner — informacyjny panel cookies
  Domyślnie ukryty; cookie-banner.js ujawnia go gdy potrzeba.
-->
<div
  id="cookie-banner"
  role="dialog"
  aria-modal="false"
  aria-labelledby="cb-title"
  aria-hidden="true"
  aria-live="polite"
  hidden
>
  <div class="cb-header">
    <span class="cb-icon" aria-hidden="true">🍪</span>
    <span class="cb-title" id="cb-title">Informacja o cookies</span>
  </div>
  <p class="cb-body">
    Ta strona nie&nbsp;używa plików cookies reklamowych
    ani&nbsp;śledzących. Więcej informacji:
    <a href="/polityka-prywatnosci/">Polityka prywatności</a>.
  </p>
  <div class="cb-actions">
    <button
      id="cookie-banner-accept"
      type="button"
    >Rozumiem</button>
  </div>
</div>
