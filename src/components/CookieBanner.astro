<!--
  CookieBanner — informacyjny pasek cookies (pill style)
  Wzorowany na Studio Ahremark: jeden wiersz, kapsułka.
  Domyślnie hidden; cookie-banner.js ujawnia gdy potrzeba.
-->
<div
  id="cookie-banner"
  role="region"
  aria-label="Informacja o cookies"
  aria-hidden="true"
  hidden
>
  <!-- Panel szczegółowy Info (pojawia się nad kapsułką po kliknięciu "Info") -->
  <div
    class="cb-info-panel"
    id="cb-info-panel"
    role="dialog"
    aria-modal="false"
    aria-labelledby="cb-info-title"
    hidden
  >
    <div class="cb-info-header">
      <span class="cb-info-title" id="cb-info-title">Informacja o&nbsp;cookies</span>
      <button
        class="cb-info-close"
        id="cb-info-close"
        type="button"
        aria-label="Zamknij"
      >×</button>
    </div>
    <p class="cb-info-text">
      Zapamiętujemy zamknięcie tego&nbsp;komunikatu. Szczegóły znajdziesz w&nbsp;polityce prywatności.
    </p>
    <a class="cb-info-link" href="/polityka-prywatnosci/">Polityka prywatności <span aria-hidden="true">&rarr;</span></a>
  </div>

  <!-- Kapsułka: Cookies [Rozumiem] [Info] -->
  <div class="cb-pill">
    <span class="cb-label" aria-hidden="true">Cookies</span>
    <button
      id="cookie-banner-accept"
      type="button"
      class="cb-btn-primary"
    >Rozumiem</button>
    <button
      id="cookie-banner-info"
      type="button"
      class="cb-btn-text"
      aria-expanded="false"
      aria-controls="cb-info-panel"
    >Info</button>
  </div>
</div>
