---
import { ui } from '../data/i18n/ui';

interface Props {
  lang?: 'pl' | 'en';
}

const { lang = 'pl' } = Astro.props;
const isEn = lang === 'en';
const t = ui[lang].cookieBanner;
const privacyHref = isEn ? '/en/privacy-policy/' : '/polityka-prywatnosci/';
---
<!--
  CookieBanner — zwarta karta informacyjna o prywatności
  Matowe szkło, lewy dolny róg, prostokątna karta z zaokrąglonymi narożnikami.
  Tekst na górze karty, pod nim przyciski: [Dowiedz się więcej] [Zamknij].
  Domyślnie hidden; cookie-banner.js ujawnia, gdy potrzeba.
-->
<div
  id="cookie-banner"
  role="region"
  aria-label={t.regionAria}
  aria-hidden="true"
  hidden
  lang={isEn ? 'en-GB' : 'pl'}
>
  <!-- Panel szczegółowy (otwierany nad kartą po kliknięciu "Dowiedz się więcej") -->
  <div
    class="cb-info-panel"
    id="cb-info-panel"
    role="dialog"
    aria-modal="false"
    aria-labelledby="cb-info-title"
    hidden
  >
    <div class="cb-info-header">
      <span class="cb-info-title" id="cb-info-title">{t.panelTitle}</span>
      <button
        class="cb-info-close"
        id="cb-info-close"
        type="button"
        aria-label={t.panelCloseAria}
      >×</button>
    </div>
    <p class="cb-info-text">
      {t.panelText}
    </p>
    <a class="cb-info-link" href={privacyHref}>{t.privacyLinkText} <span aria-hidden="true">&rarr;</span></a>
  </div>

  <!-- Karta prywatności: treść widoczna od razu + przyciski -->
  <div class="cb-card">
    <p class="cb-card-text">{t.bannerText}</p>
    <div class="cb-card-actions">
      <button
        id="cookie-banner-privacy"
        type="button"
        class="cb-btn-privacy"
        aria-expanded="false"
        aria-controls="cb-info-panel"
      >{t.btnPrivacy}</button>
      <button
        id="cookie-banner-close"
        type="button"
        class="cb-btn-close"
      >{t.btnClose}</button>
    </div>
  </div>
</div>
