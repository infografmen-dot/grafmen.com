---
import CtaArrow from './CtaArrow.astro';
import { ui } from '../data/i18n/ui';

interface Props {
  currentNav?: 'home' | 'web' | 'brand' | 'work' | 'about' | 'blog' | 'contact';
  lang?: 'pl' | 'en';
  altLangUrl?: string;
}

const { currentNav, lang = 'pl', altLangUrl } = Astro.props;
const isHome = currentNav === 'home';
const isEn = lang === 'en';
const t = ui[lang].nav;

const homeHref = isEn ? '/en/' : '/';
const webHref = isEn ? '/en/websites/' : '/strony-www/';
const brandHref = isEn ? '/en/branding/' : '/branding/';
const workHref = isEn ? '/en/portfolio/' : '/portfolio/';
const aboutHref = isEn ? '/en/about/' : '/o-mnie/';
const blogHref = isEn ? '/en/blog/' : '/blog/';
const contactHref = isEn ? '/en/contact/' : '/kontakt/';

const svgLogoSrc = "data:image/svg+xml;base64,";
---
<div class="site-header-shell">
  <div class="wrap">
    <header>
      <a class="home-logo" href={homeHref} aria-label={t.homeAria}>
        {isHome ? (
          <>
            <video
              class="logo-video"
              autoplay
              muted
              playsinline
              preload="auto"
              poster="/assets/motion/grafmen-logo-poster.png"
              width="142"
              height="47"
              aria-hidden="true"
              disablepictureinpicture
              disableremoteplayback
              controlslist="nodownload nofullscreen noremoteplayback"
              tabindex="-1"
              data-edge-visual-search="false"
            >
              <source src="/assets/motion/grafmen-logo.webm" type="video/webm" />
              <source src="/assets/motion/grafmen-logo.mp4" type="video/mp4" />
            </video>
            <img class="logo logo--static-fallback" src={svgLogoSrc} alt="Grafmen" width="142" height="47" />
          </>
        ) : (
          <img class="logo" src={svgLogoSrc} alt="Grafmen" width="142" height="47" />
        )}
      </a>
      <nav id="main-nav" aria-label={t.mainNavAria}>
        <a data-nav="web" class={currentNav === 'web' ? 'active' : ''} aria-current={currentNav === 'web' ? 'page' : undefined} href={webHref}>
          <span class="nav-flip"><span class="nav-flip-front">{t.web}</span><span class="nav-flip-back" aria-hidden="true">{t.web}</span></span>
        </a>
        <a data-nav="brand" class={currentNav === 'brand' ? 'active' : ''} aria-current={currentNav === 'brand' ? 'page' : undefined} href={brandHref}>
          <span class="nav-flip"><span class="nav-flip-front">{t.brand}</span><span class="nav-flip-back" aria-hidden="true">{t.brand}</span></span>
        </a>
        <a data-nav="work" class={currentNav === 'work' ? 'active' : ''} aria-current={currentNav === 'work' ? 'page' : undefined} href={workHref}>
          <span class="nav-flip"><span class="nav-flip-front">{t.work}</span><span class="nav-flip-back" aria-hidden="true">{t.work}</span></span>
        </a>
        <a data-nav="about" class={currentNav === 'about' ? 'active' : ''} aria-current={currentNav === 'about' ? 'page' : undefined} href={aboutHref}>
          <span class="nav-flip"><span class="nav-flip-front">{t.about}</span><span class="nav-flip-back" aria-hidden="true">{t.about}</span></span>
        </a>
        <a data-nav="blog" class={currentNav === 'blog' ? 'active' : ''} aria-current={currentNav === 'blog' ? 'page' : undefined} href={blogHref}>
          <span class="nav-flip"><span class="nav-flip-front">{t.blog}</span><span class="nav-flip-back" aria-hidden="true">{t.blog}</span></span>
        </a>
        <a data-nav="contact" class={`nav-contact ${currentNav === 'contact' ? 'active' : ''}`} aria-current={currentNav === 'contact' ? 'page' : undefined} href={contactHref}>
          <span class="nav-flip"><span class="nav-flip-front">{t.contact}</span><span class="nav-flip-back" aria-hidden="true">{t.contact}</span></span>
        </a>
      </nav>
      <div class="tools">
        <div class="language-switch" role="group" aria-label={t.langSwitchAria}>
          {isEn ? (
            <a href={altLangUrl || '/'} class="lang-btn" aria-label={t.switchToPl}>PL</a>
          ) : (
            <span class="lang-btn is-active" aria-current="true">PL</span>
          )}
          <span aria-hidden="true" class="lang-sep">/</span>
          {isEn ? (
            <span class="lang-btn is-active" aria-current="true">EN</span>
          ) : (
            <a href={altLangUrl || '/en/'} class="lang-btn" aria-label={t.switchToEn}>EN</a>
          )}
        </div>
        <span class="sep"></span>
        <a class="quote" href={contactHref}>
          <span>{t.quote}</span>
          <CtaArrow />
        </a>
        <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="main-nav" aria-label={t.menuOpen}>
          <svg class="menu-toggle-svg" viewBox="0 0 32 32" stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" fill="none" stroke="currentColor" aria-hidden="true">
            <path class="menu-toggle-path-top" d="M27 10 13 10C10.8 10 9 8.2 9 6 9 3.5 10.8 2 13 2 15.2 2 17 3.8 17 6L17 26C17 28.2 18.8 30 21 30 23.2 30 25 28.2 25 26 25 23.8 23.2 22 21 22L7 22" />
            <path class="menu-toggle-path-mid" d="M7 16 27 16" />
          </svg>
        </button>
      </div>
    </header>
  </div>
</div>

{isHome && (
  <script is:inline>
    (() => {
      const v = document.querySelector('.home-logo .logo-video');
      const fallback = document.querySelector('.home-logo .logo--static-fallback');
      if (!v) return;

      const showFallback = () => {
        if (fallback) fallback.style.display = 'block';
        v.style.display = 'none';
        v.pause();
      };

      if (window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        showFallback();
        return;
      }

      v.addEventListener('ended', showFallback, { once: true });
      v.addEventListener('error', showFallback, { once: true });

      // Zabezpieczenie czasowe po zakończeniu animacji (trwa 1.034s)
      setTimeout(() => {
        if (v && (v.ended || v.currentTime >= 0.95)) {
          showFallback();
        }
      }, 1200);

      const playPromise = v.play();
      if (playPromise !== undefined) {
        playPromise.catch(() => {
          // Jeśli autoplay zablokowany, wideo prezentuje poster
        });
      }
    })();
  </script>
)}
