---
interface Props {
  currentNav?: 'home' | 'web' | 'brand' | 'work' | 'about' | 'blog' | 'contact';
}

const { currentNav } = Astro.props;
---
<div class="site-header-shell">
  <div class="wrap">
    <header>
      <a class="home-logo" href="/" aria-label="Grafmen · strona główna">
        <img class="logo" src="data:image/svg+xml;base64," alt="Grafmen" width="142" height="47">
      </a>
      <nav id="main-nav" aria-label="Główna nawigacja">
        <a data-nav="web" class={currentNav === 'web' ? 'active' : ''} aria-current={currentNav === 'web' ? 'page' : undefined} href="/strony-www/">
          <span class="nav-flip"><span class="nav-flip-front">Strony WWW</span><span class="nav-flip-back" aria-hidden="true">Strony WWW</span></span>
        </a>
        <a data-nav="brand" class={currentNav === 'brand' ? 'active' : ''} aria-current={currentNav === 'brand' ? 'page' : undefined} href="/branding/">
          <span class="nav-flip"><span class="nav-flip-front">Branding</span><span class="nav-flip-back" aria-hidden="true">Branding</span></span>
        </a>
        <a data-nav="work" class={currentNav === 'work' ? 'active' : ''} aria-current={currentNav === 'work' ? 'page' : undefined} href="/portfolio/">
          <span class="nav-flip"><span class="nav-flip-front">Portfolio</span><span class="nav-flip-back" aria-hidden="true">Portfolio</span></span>
        </a>
        <a data-nav="about" class={currentNav === 'about' ? 'active' : ''} aria-current={currentNav === 'about' ? 'page' : undefined} href="/o-mnie/">
          <span class="nav-flip"><span class="nav-flip-front">O&nbsp;mnie</span><span class="nav-flip-back" aria-hidden="true">O&nbsp;mnie</span></span>
        </a>
        <a data-nav="blog" class={currentNav === 'blog' ? 'active' : ''} aria-current={currentNav === 'blog' ? 'page' : undefined} href="/blog/">
          <span class="nav-flip"><span class="nav-flip-front">Blog</span><span class="nav-flip-back" aria-hidden="true">Blog</span></span>
        </a>
        <a class={`nav-contact ${currentNav === 'contact' ? 'active' : ''}`} data-nav="contact" aria-current={currentNav === 'contact' ? 'page' : undefined} href="/kontakt/">
          <span class="nav-flip"><span class="nav-flip-front">Kontakt</span><span class="nav-flip-back" aria-hidden="true">Kontakt</span></span>
        </a>
      </nav>
      <div class="tools">
        <div class="language-switch" role="group" aria-label="Język / Language">
          <button type="button" data-language="pl" aria-pressed="true" aria-label="Polski">PL</button>
          <span aria-hidden="true">/</span>
          <button type="button" data-language="en" aria-pressed="false" aria-label="English">EN</button>
        </div>
        <span class="sep"></span>
        <a class="quote" href="/kontakt/">Kontakt <span aria-hidden="true">&rarr;</span></a>
        <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="main-nav" aria-label="Otwórz menu">
          <span class="menu-toggle-box" aria-hidden="true">
            <span class="menu-toggle-line line-1"></span>
            <span class="menu-toggle-line line-2"></span>
            <span class="menu-toggle-line line-3"></span>
          </span>
        </button>
      </div>
    </header>
  </div>
</div>
