---
---
<section class="home-section logo-cloud-section compact" id="klienci" aria-labelledby="clients-kicker" lang="pl">
  <div class="home-inner">
    <p class="home-kicker logo-cloud-kicker" id="clients-kicker">WYBRANI KLIENCI</p>
    
    <div class="logo-cloud logo-cloud--cinematic" id="logo-cloud-cinematic" aria-label="Logotypy wybranych klientów">
      <div class="logo-marquee-track">
        <div class="logo-track-group">
          <div class="logo-item"><img src="/assets/clients/drewmax.svg" alt="Drewmax.pro" width="140" height="42" loading="lazy"></div>
          <div class="logo-item"><img src="/assets/clients/drewmar.png" alt="Drewmar" width="130" height="40" loading="lazy"></div>
          <div class="logo-item"><img src="/assets/clients/unitrans.png" alt="UniTrans" width="135" height="40" loading="lazy"></div>
          <div class="logo-item"><img src="/assets/clients/salmax.png" alt="Salmax" width="125" height="38" loading="lazy"></div>
          <div class="logo-item"><img src="/assets/clients/kancelaria-lampa.png" alt="Kancelaria Radcy Prawnego Lampa" width="135" height="40" loading="lazy"></div>
          <div class="logo-item"><img src="/assets/clients/pervita24.png" alt="PerVita24" width="130" height="40" loading="lazy"></div>
          <div class="logo-item"><img src="/assets/clients/sourcetech.png" alt="Sourcetech" width="130" height="40" loading="lazy"></div>
          <div class="logo-item"><img src="/assets/clients/quero.png" alt="Quero" width="120" height="38" loading="lazy"></div>
          <div class="logo-item"><img src="/assets/clients/resto.png" alt="Resto" width="110" height="38" loading="lazy"></div>
          <div class="logo-item"><img src="/assets/clients/infosekret.png" alt="InfoSekret" width="125" height="38" loading="lazy"></div>
          <div class="logo-item"><img src="/assets/clients/e-projektowanie.png" alt="e-projektowanie" width="130" height="40" loading="lazy"></div>
        </div>
        <div class="logo-track-group" aria-hidden="true">
          <div class="logo-item"><img src="/assets/clients/drewmax.svg" alt="" width="140" height="42" loading="lazy"></div>
          <div class="logo-item"><img src="/assets/clients/drewmar.png" alt="" width="130" height="40" loading="lazy"></div>
          <div class="logo-item"><img src="/assets/clients/unitrans.png" alt="" width="135" height="40" loading="lazy"></div>
          <div class="logo-item"><img src="/assets/clients/salmax.png" alt="" width="125" height="38" loading="lazy"></div>
          <div class="logo-item"><img src="/assets/clients/kancelaria-lampa.png" alt="" width="135" height="40" loading="lazy"></div>
          <div class="logo-item"><img src="/assets/clients/pervita24.png" alt="" width="130" height="40" loading="lazy"></div>
          <div class="logo-item"><img src="/assets/clients/sourcetech.png" alt="" width="130" height="40" loading="lazy"></div>
          <div class="logo-item"><img src="/assets/clients/quero.png" alt="" width="120" height="38" loading="lazy"></div>
          <div class="logo-item"><img src="/assets/clients/resto.png" alt="" width="110" height="38" loading="lazy"></div>
          <div class="logo-item"><img src="/assets/clients/infosekret.png" alt="" width="125" height="38" loading="lazy"></div>
          <div class="logo-item"><img src="/assets/clients/e-projektowanie.png" alt="" width="130" height="40" loading="lazy"></div>
        </div>
      </div>
    </div>
  </div>
</section>
