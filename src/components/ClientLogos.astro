---
interface Props {
  lang?: 'pl' | 'en';
}

const { lang = 'pl' } = Astro.props;
const isEn = lang === 'en';
---
<section class="home-section logo-cloud-section compact" id="klienci" aria-labelledby="clients-kicker" lang={isEn ? 'en-GB' : 'pl'}>
  <div class="home-inner">
    <p class="home-kicker logo-cloud-kicker" id="clients-kicker">{isEn ? "SELECTED CLIENTS" : "WYBRANI KLIENCI"}</p>
    
    <div class="logo-cloud logo-cloud--cinematic" id="logo-cloud-cinematic" aria-label={isEn ? "Logos of selected clients" : "Logotypy wybranych klientów"}>
      <div class="logo-marquee-track">
        <div class="logo-track-group">
          <div class="logo-item"><img src="/assets/clients/marquee/drewmax.svg" alt="Drewmax.pro" width="150" height="43" loading="lazy"></div>
          <div class="logo-item"><img src="/assets/clients/marquee/drewmar.png" alt="Drewmar" width="155" height="35" loading="lazy"></div>
          <div class="logo-item"><img src="/assets/clients/marquee/unitrans.png" alt="UniTrans" width="150" height="43" loading="lazy"></div>
          <div class="logo-item"><img src="/assets/clients/marquee/salmax.png" alt="Salmax" width="155" height="32" loading="lazy"></div>
          <div class="logo-item"><img src="/assets/clients/marquee/kancelaria-lampa.png" alt="Kancelaria Radcy Prawnego Lampa" width="94" height="44" loading="lazy"></div>
          <div class="logo-item"><img src="/assets/clients/marquee/pervita24.png" alt="PerVita24" width="141" height="44" loading="lazy"></div>
          <div class="logo-item"><img src="/assets/clients/marquee/sourcetech.png" alt="Sourcetech" width="60" height="44" loading="lazy"></div>
          <div class="logo-item"><img src="/assets/clients/marquee/quero.png" alt="Quero" width="123" height="44" loading="lazy"></div>
          <div class="logo-item"><img src="/assets/clients/marquee/resto.png" alt="Resto" width="145" height="44" loading="lazy"></div>
          <div class="logo-item"><img src="/assets/clients/marquee/infosekret.png" alt="InfoSekret" width="155" height="39" loading="lazy"></div>
          <div class="logo-item"><img src="/assets/clients/marquee/e-projektowanie.png" alt="e-projektowanie" width="67" height="44" loading="lazy"></div>
        </div>
        <div class="logo-track-group" aria-hidden="true">
          <div class="logo-item"><img src="/assets/clients/marquee/drewmax.svg" alt="" width="150" height="43" loading="lazy"></div>
          <div class="logo-item"><img src="/assets/clients/marquee/drewmar.png" alt="" width="155" height="35" loading="lazy"></div>
          <div class="logo-item"><img src="/assets/clients/marquee/unitrans.png" alt="" width="150" height="43" loading="lazy"></div>
          <div class="logo-item"><img src="/assets/clients/marquee/salmax.png" alt="" width="155" height="32" loading="lazy"></div>
          <div class="logo-item"><img src="/assets/clients/marquee/kancelaria-lampa.png" alt="" width="94" height="44" loading="lazy"></div>
          <div class="logo-item"><img src="/assets/clients/marquee/pervita24.png" alt="" width="141" height="44" loading="lazy"></div>
          <div class="logo-item"><img src="/assets/clients/marquee/sourcetech.png" alt="" width="60" height="44" loading="lazy"></div>
          <div class="logo-item"><img src="/assets/clients/marquee/quero.png" alt="" width="123" height="44" loading="lazy"></div>
          <div class="logo-item"><img src="/assets/clients/marquee/resto.png" alt="" width="145" height="44" loading="lazy"></div>
          <div class="logo-item"><img src="/assets/clients/marquee/infosekret.png" alt="" width="155" height="39" loading="lazy"></div>
          <div class="logo-item"><img src="/assets/clients/marquee/e-projektowanie.png" alt="" width="67" height="44" loading="lazy"></div>
        </div>
      </div>
    </div>
  </div>
</section>
