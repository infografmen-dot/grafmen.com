---
interface Props {
  lang?: 'pl' | 'en';
}

const { lang = 'pl' } = Astro.props;
const isEn = lang === 'en';
---
<section class="home-section logo-cloud-section compact" id="klienci" aria-labelledby="clients-kicker" lang={isEn ? 'en-GB' : 'pl'}>
  <div class="home-inner">
    <p class="home-kicker logo-cloud-kicker" id="clients-kicker">{isEn ? "SELECTED CLIENTS" : "WYBRANI KLIENCI"}</p>
    
    <div class="logo-cloud logo-cloud--cinematic" id="logo-cloud-cinematic" aria-label={isEn ? "Logos of selected clients" : "Logotypy wybranych klientów"}>
      <div class="logo-marquee-track">
        <div class="logo-track-group">
          <div class="logo-item"><img src="/assets/clients/marquee/drewmax.svg" alt="Drewmax.pro" width="160" height="46" loading="lazy"></div>
          <div class="logo-item"><img src="/assets/clients/marquee/drewmar.png" alt="Drewmar" width="165" height="38" loading="lazy"></div>
          <div class="logo-item"><img src="/assets/clients/marquee/unitrans.png" alt="UniTrans" width="155" height="44" loading="lazy"></div>
          <div class="logo-item"><img src="/assets/clients/marquee/salmax.png" alt="Salmax" width="168" height="36" loading="lazy"></div>
          <div class="logo-item"><img src="/assets/clients/marquee/kancelaria-lampa.png" alt="Kancelaria Radcy Prawnego Lampa" width="115" height="54" loading="lazy"></div>
          <div class="logo-item"><img src="/assets/clients/marquee/pervita24.png" alt="PerVita24" width="155" height="48" loading="lazy"></div>
          <div class="logo-item"><img src="/assets/clients/marquee/sourcetech.png" alt="Sourcetech" width="85" height="62" loading="lazy"></div>
          <div class="logo-item"><img src="/assets/clients/marquee/quero.png" alt="Quero" width="150" height="52" loading="lazy"></div>
          <div class="logo-item"><img src="/assets/clients/marquee/resto.png" alt="Resto" width="155" height="46" loading="lazy"></div>
          <div class="logo-item"><img src="/assets/clients/marquee/infosekret.png" alt="InfoSekret" width="160" height="41" loading="lazy"></div>
          <div class="logo-item"><img src="/assets/clients/marquee/e-projektowanie.png" alt="e-projektowanie" width="113" height="74" loading="lazy"></div>
        </div>
        <div class="logo-track-group" aria-hidden="true">
          <div class="logo-item"><img src="/assets/clients/marquee/drewmax.svg" alt="" width="160" height="46" loading="lazy"></div>
          <div class="logo-item"><img src="/assets/clients/marquee/drewmar.png" alt="" width="165" height="38" loading="lazy"></div>
          <div class="logo-item"><img src="/assets/clients/marquee/unitrans.png" alt="" width="155" height="44" loading="lazy"></div>
          <div class="logo-item"><img src="/assets/clients/marquee/salmax.png" alt="" width="168" height="36" loading="lazy"></div>
          <div class="logo-item"><img src="/assets/clients/marquee/kancelaria-lampa.png" alt="" width="115" height="54" loading="lazy"></div>
          <div class="logo-item"><img src="/assets/clients/marquee/pervita24.png" alt="" width="155" height="48" loading="lazy"></div>
          <div class="logo-item"><img src="/assets/clients/marquee/sourcetech.png" alt="" width="85" height="62" loading="lazy"></div>
          <div class="logo-item"><img src="/assets/clients/marquee/quero.png" alt="" width="150" height="52" loading="lazy"></div>
          <div class="logo-item"><img src="/assets/clients/marquee/resto.png" alt="" width="155" height="46" loading="lazy"></div>
          <div class="logo-item"><img src="/assets/clients/marquee/infosekret.png" alt="" width="160" height="41" loading="lazy"></div>
          <div class="logo-item"><img src="/assets/clients/marquee/e-projektowanie.png" alt="" width="113" height="74" loading="lazy"></div>
        </div>
      </div>
    </div>
  </div>
</section>
